<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VstManager.Ui.ViewModels"
        xmlns:conv="using:VstManager.Ui.Converters"
        xmlns:li="using:VstManager.Ui.Views"
        xmlns:model="using:VstManager.Core.Models"
        x:Class="VstManager.Ui.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="VST Manager"
        Icon="avares://VstManager.Ui/Assets/app-icon.ico"
        Width="1180" Height="760"
        MinWidth="640" MinHeight="440"
        KeyDown="OnLibraryKeyDown"
        Background="{DynamicResource WindowBackgroundGradient}">

    <Window.Resources>
        <conv:CloudStateBrushConverter x:Key="CloudStateBrush" />
        <conv:CloudStateIsSyncingConverter x:Key="CloudStateIsSyncing" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToEyeIconConverter x:Key="BoolToEyeIcon" />
        <conv:BoolToFavoriteGlyphConverter x:Key="BoolToFavoriteGlyph" />

        <!-- One menu definition, attached to both templates below, so the grid and list can
             never offer different actions. Commands are reached through the window rather than
             the item's own DataContext, which is the card; ContextFlyout sits outside the
             ItemsControl's visual tree, so $parent[ItemsControl] does not resolve from here. -->
        <!-- Every item carries a MenuItem.Icon, matching WPF's own PluginMenu — a mix of vector
             Paths (reusing this session's already-ported icons where one exists) and emoji
             TextBlocks (WPF's own choice for the same item, tinted to match). -->
        <MenuFlyout x:Key="PluginMenu" x:DataType="vm:PluginCardViewModel">
            <MenuItem Classes="pluginMenuItem" Header="Details…"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenDetailsCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <Path Classes="tabIcon" Width="18" Height="18" Data="{StaticResource IconInfo}" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <MenuItem Classes="pluginMenuItem" Header="Toggle Favourite"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteGlyph}}"
                               Foreground="#FFFBBF24" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Classes="pluginMenuItem" Header="{Binding HideMenuLabel}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleHiddenCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <!-- !IsHidden: "currently visible" (the Hide action) shows an open eye,
                         "currently hidden" (the Unhide action) shows the crossed one — inverted
                         from BoolToEyeIconConverter's original ShowNotifications-style sense. -->
                    <Path Classes="tabIcon" Width="18" Height="18"
                          Data="{Binding !IsHidden, Converter={StaticResource BoolToEyeIcon}}" />
                </MenuItem.Icon>
            </MenuItem>

            <!--#if LICENSE_STATUS-->
            <Separator />

            <MenuItem Classes="pluginMenuItem" Header="Mark Legit"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MarkLegitCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsInstalled}">
                <MenuItem.Icon>
                    <Path Classes="tabIcon" Width="18" Height="18" Stroke="{DynamicResource LegitBrush}"
                          Data="{StaticResource IconCheck}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Classes="pluginMenuItem" Header="Mark Cracked"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MarkCrackedCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsInstalled}">
                <MenuItem.Icon>
                    <Path Classes="tabIcon" Width="18" Height="18" Stroke="{DynamicResource DangerBrush}"
                          Data="{StaticResource IconSkull}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Classes="pluginMenuItem" Header="Clear Classification"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MarkUnclassifiedCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsInstalled}">
                <MenuItem.Icon>
                    <Path Classes="tabIcon" Width="18" Height="18" Data="{StaticResource IconClear}" />
                </MenuItem.Icon>
            </MenuItem>
            <!--#endif-->

            <Separator />

            <MenuItem Classes="pluginMenuItem" Header="Mark as Instrument"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MarkInstrumentCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsInstalled}">
                <MenuItem.Icon>
                    <TextBlock Text="🎹" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Classes="pluginMenuItem" Header="Mark as Effect"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MarkEffectCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsInstalled}">
                <MenuItem.Icon>
                    <TextBlock Text="🎛" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>


            <Separator />

            <MenuItem Classes="pluginMenuItem" Header="Re-detect Version"
                      ToolTip.Tip="Re-reads the installed version from the plugin file"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RefreshMetadataCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsInstalled}">
                <MenuItem.Icon>
                    <Path Classes="tabIcon" Width="18" Height="18" Data="{StaticResource IconRefresh}" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).HasFolders}" />

            <!-- A Click handler opening its own small picker window, not a nested submenu: this
                 flyout's MenuItem submenus did not reliably open on hover when tried here (see
                 FolderPickerWindow's doc comment for how that was confirmed). Click, not Command,
                 since the handler needs the card straight off this item's own DataContext. -->
            <MenuItem Classes="pluginMenuItem" Header="Move to Folder…"
                      IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).HasFolders}"
                      Click="MoveToFolder_Click">
                <MenuItem.Icon>
                    <TextBlock Text="🗂" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <!-- Click, not Command: the confirmation wording depends on whether a registered
                 uninstaller was found, which the window has to look up before it knows what to
                 ask — see Uninstall_Click. -->
            <MenuItem Classes="pluginMenuItem" Header="Uninstall…" Foreground="{DynamicResource DangerBrush}"
                      IsEnabled="{Binding IsInstalled}"
                      Click="Uninstall_Click">
                <MenuItem.Icon>
                    <TextBlock Text="✖" Foreground="{DynamicResource DangerBrush}" FontSize="18" />
                </MenuItem.Icon>
            </MenuItem>
        </MenuFlyout>

        <!-- Card body, shared by the grid and list templates so the two layouts can never
             drift apart in what they show. -->
        <!-- Redesigned to an app-icon-style layout: a large centered thumbnail on top, with
             name/vendor/star/badges/tags centered underneath, rather than the previous
             left-aligned icon+text row — an explicit ask, not a tweak, since the old row read as
             cramped with a small 34x34 thumbnail fighting the text for space. -->
        <DataTemplate x:Key="CardTemplate" x:DataType="vm:PluginCardViewModel">
            <Border Classes="card" Classes.selected="{Binding IsSelected}"
                    Focusable="True"
                    ContextFlyout="{StaticResource PluginMenu}"
                    PointerPressed="OnPluginPointerPressed">
                <StackPanel Spacing="10" HorizontalAlignment="Center">

                    <Grid Classes="cardTop" ColumnDefinitions="*,Auto,*">
                        <Border Grid.Column="1" Classes="cardLogo"
                                CornerRadius="{DynamicResource RadiusMedium}"
                                Background="{DynamicResource SurfaceAltBrush}"
                                ClipToBounds="True">
                            <Panel>
                                <TextBlock Text="{Binding Initial}"
                                           IsVisible="{Binding Logo, Converter={x:Static ObjectConverters.IsNull}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Classes="cardInitial" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Image Source="{Binding Logo}" Stretch="Uniform" />
                                <Border Background="#99000000" IsVisible="{Binding IsRefreshingMetadata}"
                                        ToolTip.Tip="Looking up this plugin…">
                                    <Viewbox Margin="6">
                                        <li:LoadingSpinner IsActive="{Binding IsRefreshingMetadata}"
                                                             Foreground="{DynamicResource AccentBrush}" />
                                    </Viewbox>
                                </Border>
                            </Panel>
                        </Border>

                        <ToggleButton Grid.Column="2" Classes="star"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                                      CommandParameter="{Binding}"
                                      ToolTip.Tip="Favourite" />
                    </Grid>

                    <StackPanel Spacing="1" HorizontalAlignment="Center">
                        <TextBlock Classes="title" Text="{Binding Name}"
                                   ToolTip.Tip="{Binding Name}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Classes="subtitle" Text="{Binding Vendor}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>

                    <TextBlock Classes="meta cardDetail" Text="{Binding SummaryLine}"
                               HorizontalAlignment="Center" />

                    <WrapPanel Classes="cardDetail" ItemSpacing="6" LineSpacing="6" HorizontalAlignment="Center">
                        <!--#if LICENSE_STATUS-->
                        <Border Classes="chip status"
                                Classes.legit="{Binding IsLegit}"
                                Classes.cracked="{Binding IsCracked}"
                                Classes.muted="{Binding IsUnclassified}">
                            <TextBlock Text="{Binding TagLabel}" />
                        </Border>
                        <!--#endif-->

                        <Border Classes="chip status new" IsVisible="{Binding IsNew}">
                            <TextBlock Text="NEW" />
                        </Border>

                        <Border Classes="chip status outdated" IsVisible="{Binding ShowOutdatedBadge}"
                                ToolTip.Tip="{Binding UpdateTooltip}">
                            <TextBlock Text="OUTDATED" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="6" LineSpacing="6" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate" x:DataType="vm:PluginCardViewModel">
            <Border Classes="row" Classes.selected="{Binding IsSelected}"
                    Focusable="True"
                    ContextFlyout="{StaticResource PluginMenu}"
                    PointerPressed="OnPluginPointerPressed">
                <!-- Star-sized name/vendor with a capped vendor column: at wide window sizes a
                     pure 2*/1.4* split pushed the vendor into the middle of empty space. -->
                <Grid ColumnDefinitions="Auto,*,220,150,Auto" VerticalAlignment="Center">

                    <Border Grid.Column="0" Classes="rowIcon" Margin="0,0,12,0"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True">
                        <Panel>
                            <TextBlock Text="{Binding Initial}"
                                       IsVisible="{Binding Logo, Converter={x:Static ObjectConverters.IsNull}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Image Source="{Binding Logo}" Stretch="Uniform" />
                            <Border Background="#99000000" IsVisible="{Binding IsRefreshingMetadata}"
                                    ToolTip.Tip="Looking up this plugin…">
                                <Viewbox Margin="3">
                                    <li:LoadingSpinner IsActive="{Binding IsRefreshingMetadata}"
                                                         Foreground="{DynamicResource AccentBrush}" />
                                </Viewbox>
                            </Border>
                        </Panel>
                    </Border>

                    <TextBlock Grid.Column="1" Classes="title" Text="{Binding Name}"
                               ToolTip.Tip="{Binding Name}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Classes="subtitle" Text="{Binding Vendor}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="3" Classes="meta" Text="{Binding SummaryLine}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <!--#if LICENSE_STATUS-->
                        <Border Classes="chip status"
                                Classes.legit="{Binding IsLegit}"
                                Classes.cracked="{Binding IsCracked}"
                                Classes.muted="{Binding IsUnclassified}">
                            <TextBlock Text="{Binding TagLabel}" />
                        </Border>
                        <!--#endif-->
                        <Border Classes="chip status outdated" IsVisible="{Binding ShowOutdatedBadge}"
                                ToolTip.Tip="{Binding UpdateTooltip}">
                            <TextBlock Text="OUTDATED" />
                        </Border>
                        <ToggleButton Classes="star"
                                      IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                                      CommandParameter="{Binding}"
                                      ToolTip.Tip="Favourite" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Density: Default sizes here, overridden by the scroller's compact/large class. -->
        <Style Selector="Border.card"><Setter Property="Width" Value="252" /></Style>
        <Style Selector="Grid.cardTop"><Setter Property="Width" Value="220" /></Style>
        <Style Selector="Border.cardLogo"><Setter Property="Width" Value="64" /><Setter Property="Height" Value="64" /></Style>
        <Style Selector="TextBlock.cardInitial"><Setter Property="FontSize" Value="26" /></Style>
        <Style Selector="Border.rowIcon"><Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /></Style>

        <Style Selector="ScrollViewer.compact Border.card"><Setter Property="Width" Value="196" /></Style>
        <Style Selector="ScrollViewer.compact Grid.cardTop"><Setter Property="Width" Value="170" /></Style>
        <Style Selector="ScrollViewer.compact Border.cardLogo"><Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" /></Style>
        <Style Selector="ScrollViewer.compact TextBlock.cardInitial"><Setter Property="FontSize" Value="18" /></Style>
        <Style Selector="ScrollViewer.compact TextBlock.cardDetail"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="ScrollViewer.compact WrapPanel.cardDetail"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="ScrollViewer.compact Border.rowIcon"><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /></Style>
        <Style Selector="ScrollViewer.compact Border.row"><Setter Property="Padding" Value="10,4" /><Setter Property="Margin" Value="0,0,0,4" /></Style>

        <Style Selector="ScrollViewer.large Border.card"><Setter Property="Width" Value="320" /></Style>
        <Style Selector="ScrollViewer.large Grid.cardTop"><Setter Property="Width" Value="288" /></Style>
        <Style Selector="ScrollViewer.large Border.cardLogo"><Setter Property="Width" Value="96" /><Setter Property="Height" Value="96" /></Style>
        <Style Selector="ScrollViewer.large TextBlock.cardInitial"><Setter Property="FontSize" Value="38" /></Style>
        <Style Selector="ScrollViewer.large Border.rowIcon"><Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /></Style>
        <Style Selector="ScrollViewer.large Border.row"><Setter Property="Padding" Value="14,14" /></Style>

        <!-- Pulses the cloud icon while actively syncing, matching the WPF toolbar's
             DataTrigger + Storyboard. Alternate playback is Avalonia's auto-reverse. -->
        <Style Selector="Path.cloudIcon.syncing">
            <Style.Animations>
                <Animation Duration="0:0:0.7" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- More breathing room than Fluent's cramped default MenuItem, specifically for the
             plugin context menu's 10 items (PluginMenu) — found too small/cluttered once icons
             were added to every item. Scoped to .pluginMenuItem so the small folder-row context
             menu elsewhere in this file is unaffected. -->
        <Style Selector="MenuItem.pluginMenuItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </Window.Styles>

    <!-- The zoom wrapper. LayoutTransformControl, not RenderTransform: it re-runs layout at the
         scaled size, so the card grid still reflows, scrolling still works and nothing is just a
         stretched bitmap. The toast host and zoom readout sit outside it so they keep a constant
         size regardless of zoom. -->
    <Panel>
        <LayoutTransformControl x:Name="ZoomHost">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Header ......................................................... -->
        <Grid Grid.Row="0" Margin="20,18,20,10" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="VST Manager" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Classes="subtitle" Text="{Binding StatusLine}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button Classes="ghost" Command="{Binding ToggleThemeCommand}"
                        ToolTip.Tip="Switch between light and dark">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="◐" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="Theme" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Cloud indicator. Only shown once sync is on, so a user who never enables it
                     never sees a permanently grey icon asking to be explained. A cloud silhouette
                     rather than a plain dot, matching the WPF toolbar; the "syncing" class drives
                     the pulse animation declared above. -->
                <Button Classes="ghost" Command="{Binding SyncCloudNowCommand}"
                        IsVisible="{Binding CloudSyncEnabled}"
                        ToolTip.Tip="{Binding CloudStatusMessage}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="cloudIcon" Width="20" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center"
                              Classes.syncing="{Binding CloudState, Converter={StaticResource CloudStateIsSyncing}}"
                              Fill="{Binding CloudState, Converter={StaticResource CloudStateBrush}}"
                              Data="{StaticResource CloudGlyph}" />
                        <TextBlock Text="Sync" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="ghost" Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Settings">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⚙" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="accent" Command="{Binding RescanCommand}"
                        IsEnabled="{Binding !IsScanning}"
                        ToolTip.Tip="Rescan your plugin folders">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Data="{StaticResource IconSearch}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.2"
                              StrokeLineCap="Round" VerticalAlignment="Center" />
                        <TextBlock Text="Rescan" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Always exits, even with "Minimize to tray" on — Close() alone would just hide
                     the window in that case (see OnMainWindowClosing). -->
                <Button Classes="ghost" Click="Quit_Click"
                        ToolTip.Tip="Quit VST Manager">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⏻" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="Quit" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Toolbar. Wraps rather than clips, so a narrow window stacks its groups. -->
        <WrapPanel Grid.Row="1" Margin="20,0,20,10" ItemSpacing="10" LineSpacing="10">

            <TextBox Classes="search" Width="280"
                     PlaceholderText="Search plugins or vendors…"
                     Text="{Binding SearchText}" />

            <!--#if LICENSE_STATUS-->
            <Border Classes="segmentGroup">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton Classes="segment all" GroupName="mode" Content="All"
                                 IsChecked="{Binding IsModeAll}"
                                 ToolTip.Tip="Show all plugins" />
                    <RadioButton x:Name="LegitSegment" Classes="segment legit" GroupName="mode"
                                 IsChecked="{Binding IsModeLegit}"
                                 ToolTip.Tip="Show only legit plugins">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="segmentIcon" Data="{StaticResource IconCheck}"
                                  Stroke="{Binding #LegitSegment.Foreground}" />
                            <TextBlock Text="Legit" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CrackedSegment" Classes="segment cracked" GroupName="mode"
                                 IsChecked="{Binding IsModeCracked}"
                                 ToolTip.Tip="Show only cracked plugins">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="segmentIcon" Data="{StaticResource IconSkull}"
                                  Stroke="{Binding #CrackedSegment.Foreground}" />
                            <TextBlock Text="Cracked" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
            <!--#endif-->

            <Border Classes="segmentGroup">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <!-- Two-way IsChecked rather than a Command: RadioButton does not invoke
                         Command on a programmatic Select(), and a OneWay binding fights the
                         click. Binding the state directly makes both paths agree. -->
                    <RadioButton Classes="segment plain" GroupName="layout" Content="▦  Grid"
                                 IsChecked="{Binding IsGrid}"
                                 ToolTip.Tip="Grid view" />
                    <RadioButton Classes="segment plain" GroupName="layout" Content="☰  List"
                                 IsChecked="{Binding IsList}"
                                 ToolTip.Tip="List view" />
                </StackPanel>
            </Border>

            <Border Classes="segmentGroup">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton Classes="segment plain" GroupName="density" Content="Compact"
                                 IsChecked="{Binding IsCompact}" ToolTip.Tip="Compact" />
                    <RadioButton Classes="segment plain" GroupName="density" Content="Default"
                                 IsChecked="{Binding IsDefaultDensity}" ToolTip.Tip="Default" />
                    <RadioButton Classes="segment plain" GroupName="density" Content="Large"
                                 IsChecked="{Binding IsLarge}" ToolTip.Tip="Large" />
                </StackPanel>
            </Border>

            <!-- SelectedValue is bound straight to the Sort enum property (SelectedValueBinding
                 picks it off each item's Tag, set here to the enum member itself rather than its
                 string name), so this is a genuine two-way binding rather than an event handler —
                 the same reason WPF's own sort control (RadioButtons bound to SortOption via
                 EnumEqualsConverter) never needed separate code to restore the persisted choice on
                 launch: a live two-way binding re-reads the current value from the view model as
                 soon as it exists, with nothing extra to wire up in either direction. -->
            <!-- Filter popup: Status/Format/Tags narrowing, matching WPF's dedicated Filter
                 button — previously absent from this project entirely (only the Favourites/
                 Updates/Hidden toggles below existed). IconFunnel is a filled silhouette (WPF's
                 Styles.xaml:29), not a stroke icon, so Fill tracks the toggle's own Foreground
                 the same way the Legit/Cracked segment icons do. -->
            <!-- The dot badge is a separate visual from :checked (already "popup is open" —
                 see Controls.axaml) so the two states — filter applied vs. popup open — never
                 fight over the same style hook. Subtle by design (a small dot, not the
                 accent-fill filterToggle chips use below): this button can be "on" from several
                 independent things at once (Status/Format/Tags/Hidden), so a full color swap
                 would read as louder than warranted. -->
            <Panel>
                <ToggleButton x:Name="FilterToggle" Classes="ghost" Padding="10,5"
                              ToolTip.Tip="Narrow the list by status, format, tags and more">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="{StaticResource IconFunnel}" Stretch="Uniform" Width="13" Height="13"
                              Fill="{Binding #FilterToggle.Foreground}" />
                        <TextBlock Text="Filter" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Border IsHitTestVisible="False" IsVisible="{Binding IsAnyFilterActive}"
                        Width="7" Height="7" CornerRadius="4"
                        Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-2,-2,0" />
            </Panel>

            <Popup PlacementTarget="{Binding #FilterToggle}"
                   Placement="Bottom" IsOpen="{Binding #FilterToggle.IsChecked, Mode=TwoWay}"
                   IsLightDismissEnabled="True">
                <Border Classes="section" Width="260" Margin="0,6,0,0" Padding="12">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Filters" Classes="label" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="ghost" Content="Reset" Padding="8,3" FontSize="12"
                                    Command="{Binding ResetFiltersCommand}" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Status" Classes="meta" />
                            <Border Classes="segmentGroup">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Classes="segment" GroupName="filterStatus" Content="All"
                                                 IsChecked="{Binding IsStatusAll}" />
                                    <RadioButton Classes="segment" GroupName="filterStatus" Content="Installed"
                                                 IsChecked="{Binding IsStatusInstalled}" />
                                    <RadioButton Classes="segment" GroupName="filterStatus" Content="Not Installed"
                                                 IsChecked="{Binding IsStatusNotInstalled}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Format" Classes="meta" />
                            <Border Classes="segmentGroup">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Classes="segment" GroupName="filterFormat" Padding="{OnPlatform '8,6', macOS='5,6'}" Content="All"
                                                 IsChecked="{Binding IsFormatAll}" />
                                    <RadioButton Classes="segment" GroupName="filterFormat" Padding="{OnPlatform '8,6', macOS='5,6'}" Content="VST2"
                                                 IsChecked="{Binding IsFormatVst2}" />
                                    <RadioButton Classes="segment" GroupName="filterFormat" Padding="{OnPlatform '8,6', macOS='5,6'}" Content="VST3"
                                                 IsChecked="{Binding IsFormatVst3}" />
                                    <RadioButton Classes="segment" GroupName="filterFormat" Padding="{OnPlatform '8,6', macOS='5,6'}" Content="AAX"
                                                 IsChecked="{Binding IsFormatAax}" />
                                    <RadioButton Classes="segment" GroupName="filterFormat" Padding="{OnPlatform '8,6', macOS='5,6'}" Content="CLAP"
                                                 IsChecked="{Binding IsFormatClap}" />
                                    <RadioButton Classes="segment" GroupName="filterFormat" Padding="5,6" Content="AU"
                                                 IsVisible="{x:Static vm:MainViewModel.ShowAuFormat}"
                                                 IsChecked="{Binding IsFormatAu}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ToggleSwitch, not CheckBox, matching the earlier Settings-window
                             session so this new popup doesn't reintroduce a checkbox. -->
                        <ToggleSwitch IsChecked="{Binding ShowHidden}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="tabIcon" Width="13" Height="13"
                                      Data="{Binding ShowHidden, Converter={StaticResource BoolToEyeIcon}}"
                                      Stroke="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Show hidden plugins" />
                            </StackPanel>
                        </ToggleSwitch>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Tags" Classes="meta" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="ghost" Content="Clear" Padding="6,1" FontSize="11"
                                    Command="{Binding ClearTagFilterCommand}"
                                    IsVisible="{Binding HasTagFilter}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AvailableTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="model:TagDefinition">
                                    <Button Classes="ghost"
                                            Padding="8,4" FontSize="11"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleTagFilterCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <ComboBox MinWidth="150" VerticalAlignment="Center"
                      ToolTip.Tip="Sort order"
                      SelectedValueBinding="{CompiledBinding Tag, x:DataType=ComboBoxItem}"
                      SelectedValue="{Binding Sort}">
                <ComboBoxItem Content="Sort: Name" Tag="{x:Static vm:SortOption.Name}" />
                <ComboBoxItem Content="Sort: Vendor" Tag="{x:Static vm:SortOption.Vendor}" />
                <ComboBoxItem Content="Sort: Type" Tag="{x:Static vm:SortOption.Type}" />
                <ComboBoxItem Content="Sort: Date Added" Tag="{x:Static vm:SortOption.DateAdded}" />
                <ComboBoxItem Content="Sort: Updates" Tag="{x:Static vm:SortOption.UpdateStatus}" />
            </ComboBox>

            <Button Classes="ghost" Command="{Binding ReverseSortDirectionCommand}"
                    ToolTip.Tip="Reverse sort direction">
                <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⇅" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Reverse" VerticalAlignment="Center" />
                    </StackPanel>
            </Button>

            <ToggleButton Classes="filterToggle" Content="★ Favourites"
                          IsChecked="{Binding FavoritesOnly}"
                          ToolTip.Tip="Show only your favourite plugins" />
            <ToggleButton Classes="filterToggle" Content="↻ Updates"
                          IsChecked="{Binding OutdatedOnly}"
                          ToolTip.Tip="Show only plugins with a newer version available" />
            <!-- IconEyeOff (crossed) when hidden plugins are NOT shown, IconEye (open) when they
                 are — the icon reflects the toggle's actual current state, not just a static
                 label, since ShowHidden's own name reads ambiguously at a glance otherwise. -->
            <ToggleButton x:Name="HiddenToggle" Classes="filterToggle"
                          IsChecked="{Binding ShowHidden}"
                          ToolTip.Tip="Show plugins you have hidden">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="tabIcon" Width="13" Height="13"
                          Data="{Binding ShowHidden, Converter={StaticResource BoolToEyeIcon}}"
                          Stroke="{Binding #HiddenToggle.Foreground}" />
                    <TextBlock Text="Hidden" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <!--#if LICENSE_STATUS-->
            <!-- Bulk tag: mark every currently-visible installed plugin, distinct from the
                 per-card "Mark Legit/Cracked" in the context menu and selection bar. -->
            <ToggleButton x:Name="MarkAllToggle" Classes="ghost" Padding="10,5"
                          ToolTip.Tip="Mark all visible installed plugins by tag">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🏷" FontSize="13" />
                    <TextBlock Text="Mark All" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <Popup PlacementTarget="{Binding #MarkAllToggle}"
                   Placement="Bottom" IsOpen="{Binding #MarkAllToggle.IsChecked, Mode=TwoWay}"
                   IsLightDismissEnabled="True">
                <Border Classes="section" Width="200" Margin="0,6,0,0" Padding="6">
                    <StackPanel>
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding MarkAllLegitCommand}"
                                ToolTip.Tip="Mark all visible installed plugins as Legit">
                            <TextBlock Text="✓ Mark All Legit" />
                        </Button>
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Margin="0,4,0,0"
                                Command="{Binding MarkAllCrackedCommand}"
                                ToolTip.Tip="Mark all visible installed plugins as Cracked">
                            <TextBlock Text="☠ Mark All Cracked" />
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
            <!--#endif-->

            <!-- Label and target scope both switch on selection — see
                 MainViewModel.RefreshMetadataButtonLabel/RefreshAllMetadataAsync, which is the
                 method this button's Click handler actually calls despite the (unchanged) name:
                 "all" only when nothing is selected. -->
            <Button Classes="ghost" Padding="10,5"
                    Click="RefreshAllMetadata_Click"
                    ToolTip.Tip="{Binding RefreshMetadataButtonTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="↻" FontSize="13" />
                    <TextBlock Text="{Binding RefreshMetadataButtonLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- Folders. A place, not a filter chip: the user's own structure, so it gets its own
             collapsible section rather than one more toggle in the row above. This layout has no
             sidebar to nest a tree inside like WPF's, so a folder narrows the main grid via
             SelectedFolderId instead of hosting its own inline grid — clicking a row is "show me
             just this" and behaves like the other single-choice filters (Legit/Cracked/etc). -->
        <Border Grid.Row="2" Classes="section" Margin="20,0,20,10" Padding="12,10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <ToggleButton Grid.Column="0" Classes="ghost" Padding="4"
                                  IsChecked="{Binding IsFoldersExpanded}"
                                  IsVisible="{Binding HasFolders}">
                        <Panel>
                            <TextBlock Text="▾" IsVisible="{Binding $parent[ToggleButton].IsChecked}" />
                            <TextBlock Text="▸" IsVisible="{Binding !$parent[ToggleButton].IsChecked}" />
                        </Panel>
                    </ToggleButton>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="📂" FontSize="14" />
                        <TextBlock Text="Folders" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Classes="chip" IsVisible="{Binding SelectedFolder, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding SelectedFolder.Name}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="2" Classes="ghost" Padding="8,4" FontSize="12" Margin="0,0,6,0"
                            Content="✕ Show All"
                            IsVisible="{Binding SelectedFolder, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Command="{Binding ClearFolderFilterCommand}" />

                    <Button Grid.Column="3" Classes="ghost" Padding="8,4" FontSize="12"
                            ToolTip.Tip="Create a new top-level folder"
                            Command="{Binding CreateFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="+" FontSize="13" />
                            <TextBlock Text="New Folder" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding VisibleFolders}" IsVisible="{Binding IsFoldersExpanded}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderNodeViewModel">
                            <Border CornerRadius="8" Padding="8,6" Margin="{Binding Indent}"
                                    Background="Transparent"
                                    Classes.dropTarget="{Binding IsDropTarget}"
                                    Classes.active="{Binding IsSelected}"
                                    PointerPressed="OnFolderRowPressed"
                                    DragDrop.AllowDrop="True"
                                    DragDrop.DragOver="FolderRow_DragOver"
                                    DragDrop.DragLeave="FolderRow_DragLeave"
                                    DragDrop.Drop="FolderRow_Drop">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem Header="New Sub-folder"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CreateFolderCommand}"
                                                  CommandParameter="{Binding Id}" />
                                        <MenuItem Header="Edit…" Click="EditFolder_Click" />
                                        <Separator />
                                        <MenuItem Header="Move to Top Level"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveFolderToRootCommand}"
                                                  CommandParameter="{Binding Id}" />
                                        <Separator />
                                        <MenuItem Header="Delete Folder" Click="DeleteFolder_Click" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>

                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Classes="meta" VerticalAlignment="Center"
                                               Text="{Binding TotalCount, StringFormat='{}{0}'}" />

                                    <Border DockPanel.Dock="Left" Width="4" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                            Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />

                                    <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayIcon}" FontSize="14" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />

                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="meta" IsVisible="{Binding !HasFolders}" TextWrapping="Wrap"
                           Text="No folders yet — use New Folder above, or right-click a plugin to file it once you have one." />
            </StackPanel>
        </Border>

        <!-- Selection bar, only while something is selected. ................ -->
        <Border Grid.Row="3" Margin="20,0,20,10" Padding="12,8"
                IsVisible="{Binding HasSelection}"
                Background="{DynamicResource SurfaceAltBrush}"
                CornerRadius="{DynamicResource RadiusMedium}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" />

                <!-- These pass the *anchor* card; ApplyToTargets then expands to the whole
                     selection, so one command serves both the menu and this bar. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <!--#if LICENSE_STATUS-->
                    <Button Classes="ghost" Content="Legit"
                            Command="{Binding MarkLegitCommand}"
                            CommandParameter="{Binding SelectionAnchor}" />
                    <Button Classes="ghost" Content="Cracked"
                            Command="{Binding MarkCrackedCommand}"
                            CommandParameter="{Binding SelectionAnchor}" />
                    <!--#endif-->
                    <Button Classes="ghost" Content="Hide"
                            Command="{Binding ToggleHiddenCommand}"
                            CommandParameter="{Binding SelectionAnchor}" />
                    <Button Classes="ghost" Content="Clear"
                            Command="{Binding ClearSelectionCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Library ........................................................ -->
        <Panel Grid.Row="4">

            <!-- One section per category (Settings → Categories order), then Unclassified. One
                 scroller for the whole page: a section has no fixed height of its own. -->
            <ScrollViewer x:Name="GridScroll" Padding="20,0,20,20" HorizontalScrollBarVisibility="Disabled"
                          Classes.compact="{Binding IsCompact}" Classes.large="{Binding IsLarge}"
                          IsVisible="{Binding IsGrid}">
                <ItemsControl x:Name="GridSections" ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="18" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategorySectionViewModel">
                            <StackPanel Spacing="10" IsVisible="{Binding HasItems}">
                                <ToggleButton Classes="ghost sectionHeaderToggle sectionHeaderReal"
                                              IsChecked="{Binding IsExpanded}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Icon}" FontSize="14" />
                                        <TextBlock Text="{Binding Title}" Classes="sectionHeader" />
                                        <TextBlock Classes="meta" Text="{Binding Count, StringFormat='({0})'}" />
                                    </StackPanel>
                                </ToggleButton>
                                <ItemsControl Classes="sectionItems" ItemsSource="{Binding Plugins}"
                                              ItemTemplate="{StaticResource CardTemplate}"
                                              IsVisible="{Binding IsExpanded}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="14" LineSpacing="14" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer x:Name="ListScroll" Padding="20,0,20,20" HorizontalScrollBarVisibility="Disabled"
                          Classes.compact="{Binding IsCompact}" Classes.large="{Binding IsLarge}"
                          IsVisible="{Binding IsList}">
                <ItemsControl x:Name="ListSections" ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="18" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategorySectionViewModel">
                            <StackPanel Spacing="10" IsVisible="{Binding HasItems}">
                                <ToggleButton Classes="ghost sectionHeaderToggle sectionHeaderReal"
                                              IsChecked="{Binding IsExpanded}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Icon}" FontSize="14" />
                                        <TextBlock Text="{Binding Title}" Classes="sectionHeader" />
                                        <TextBlock Classes="meta" Text="{Binding Count, StringFormat='({0})'}" />
                                    </StackPanel>
                                </ToggleButton>
                                <ItemsControl Classes="sectionItems" ItemsSource="{Binding Plugins}"
                                              ItemTemplate="{StaticResource RowTemplate}"
                                              IsVisible="{Binding IsExpanded}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Designed loading and empty states rather than a blank panel. -->
            <!-- Carded so it stays legible when a metadata refresh shows it over the grid. -->
            <Border IsVisible="{Binding IsScanning}" Classes="section" Padding="28,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <li:LoadingSpinner IsActive="{Binding IsScanning}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding BusyMessage}" Classes="sectionHeader"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding IsEmpty}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Nothing matches those filters" Classes="sectionHeader"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="subtitle" HorizontalAlignment="Center"
                           Text="Try a different search, or clear the filters." />
                <Button Classes="accent" Content="Clear filters" HorizontalAlignment="Center"
                        Command="{Binding ClearFiltersCommand}" />
            </StackPanel>

            <!-- Sticky section header: shows whichever of Instruments/Effects/Unclassified Type
                 the scroll position is currently "inside", pinned to the top of the scroll
                 viewport, then swapped for the next section's text as that one's real header
                 reaches the top — classic grouped-list sticky behaviour (macOS Finder/iOS
                 Contacts). Deliberately a sibling overlay OUTSIDE the ScrollViewer, not a
                 RenderTransform on the real header: tried that first, and confirmed by testing
                 that Avalonia's ScrollContentPresenter clips a scrolled child to its own
                 (unscrolled) layout position regardless of RenderTransform, so a translated header
                 still gets clipped away exactly as if untransformed — a hard limitation of the
                 stock ScrollViewer, not a bug in the transform math. Driven entirely from
                 code-behind (UpdateStickyHeader), reading each real header's live position the
                 same way MeasureRowHeight already reads container bounds off these same
                 ScrollViewers for the row-snap wheel step. A real ToggleButton, not a plain Border
                 — it stands in for whichever real header is currently scrolled out of view, so
                 collapsing/expanding a section has to still work from here; Click forwards to
                 StickyHeader_Click, which toggles the same IsChecked the real header would. -->
            <ToggleButton x:Name="StickyHeader" Classes="ghost sectionHeaderToggle"
                          Padding="20,10,20,10" Background="{DynamicResource WindowBackgroundGradient}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Top"
                          IsVisible="False" Click="StickyHeader_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="StickyHeaderIcon" FontSize="14" />
                    <TextBlock x:Name="StickyHeaderText" Classes="sectionHeader" />
                    <TextBlock x:Name="StickyHeaderCount" Classes="meta" />
                </StackPanel>
            </ToggleButton>

        </Panel>

    </Grid>
        </LayoutTransformControl>

        <!-- Flashed on each zoom change and faded out: the keyboard and wheel shortcuts have no
             other feedback, and the clamped ends are only obvious once the number stops moving. -->
        <Border x:Name="ZoomIndicator"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusLarge}"
                Padding="28,18"
                IsHitTestVisible="False"
                Opacity="0" IsVisible="False">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Border.Transitions>
            <TextBlock x:Name="ZoomIndicatorText" Text="100%"
                       FontSize="34" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>

    </Panel>
</Window>
