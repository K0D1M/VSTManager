<Window
    x:Class="VstManager.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Draggable caption strip. ExtendsContentIntoTitleBar + SetTitleBar gives a native,
             correctly-behaving title bar for free — this replaces the WPF head's entire
             CustomTitleBar + WindowChrome + MaximizedBoundsFix + WindowCorners stack. -->
        <Grid x:ConnectionId='2' x:Name="AppTitleBar" Grid.Row="0" Height="44" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="18" Height="18" CornerRadius="5"
                        Background="{StaticResource AccentGradientBrush}" />
                <TextBlock Text="VST Manager" FontSize="13" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="4"
                        Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="WinUI" FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <muxc:NavigationView x:ConnectionId='3'
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="220"
                                                   >

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Library" Tag="library" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Settings" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Frame x:ConnectionId='4' x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Window>

