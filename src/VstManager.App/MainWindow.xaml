<Window x:Class="VstManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VstManager.App"
        xmlns:vm="clr-namespace:VstManager.App.ViewModels"
        xmlns:conv="clr-namespace:VstManager.App.Converters"
        xmlns:core="clr-namespace:VstManager.Core.Models;assembly=VstManager.Core"
        xmlns:ctrl="clr-namespace:VstManager.App.Controls"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="VST Manager" Height="680" Width="1100"
        MinHeight="480" MinWidth="720"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Style="{StaticResource ChromedWindow}"
        Loaded="Window_Loaded"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <DataTemplate x:Key="PluginCardTemplate" DataType="{x:Type vm:PluginDisplayViewModel}">
            <Border x:Name="CardRoot" Style="{StaticResource CardBorder}" Width="190" Cursor="Hand"
                    PreviewMouseLeftButtonUp="PluginCard_PreviewMouseLeftButtonUp"
                    PreviewMouseRightButtonDown="PluginCard_PreviewMouseRightButtonDown"
                    Opacity="{Binding IsHidden, Converter={StaticResource HiddenToOpacityConverter}}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="CardShadow" Color="#000000" BlurRadius="0" ShadowDepth="0"
                                      Opacity="0" Direction="270" />
                </Border.Effect>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius"
                                                 To="20" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Effect.ShadowDepth"
                                                 To="5" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                 To="0.32" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Border.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius"
                                                 To="0" Duration="0:0:0.22" />
                                <DoubleAnimation Storyboard.TargetProperty="Effect.ShadowDepth"
                                                 To="0" Duration="0:0:0.22" />
                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                 To="0" Duration="0:0:0.22" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Border.PreviewMouseLeftButtonDown">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="0.94" Duration="0:0:0.08" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="0.94" Duration="0:0:0.08" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Border.PreviewMouseLeftButtonUp">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <StackPanel>
                        <Border Width="72" Height="72" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="&#x1F3B9;" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding LogoPath, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}">
                                    <TextBlock.Opacity>
                                        <Binding Path="IsInstalled" Converter="{StaticResource OpacityConverter}" />
                                    </TextBlock.Opacity>
                                </TextBlock>
                                <Image Width="72" Height="72" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,72,72" RadiusX="10" RadiusY="10" />
                                    </Image.Clip>
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource LogoConverter}">
                                            <Binding Path="LogoPath" />
                                            <Binding Path="IsInstalled" />
                                        </MultiBinding>
                                    </Image.Source>
                                    <Image.Opacity>
                                        <Binding Path="IsInstalled" Converter="{StaticResource OpacityConverter}" />
                                    </Image.Opacity>
                                </Image>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding Vendor}" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,6" />

                        <TextBlock Text="{Binding InstalledSummaryText}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextAlignment="Center" Margin="0,0,0,10"
                                   Visibility="{Binding InstalledSummaryText, Converter={StaticResource StringToVisibilityConverter}}" />

                        <!-- Status badges share one centred, wrapping row. They used to be
                             absolutely-positioned overlays pinned to the card's bottom corners,
                             which collided with this tag (and each other) on a 190px card. -->
                        <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal"
                                   ItemWidth="Auto" ItemHeight="Auto">
                            <Border Style="{StaticResource TagBadge}" Margin="2,2"
                                    Background="{Binding Tag, Converter={StaticResource TagBrushConverter}}">
                                <TextBlock Text="{Binding Tag, Converter={StaticResource TagTextConverter}}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="White" />
                            </Border>

                            <Border Style="{StaticResource TagBadge}" Margin="2,2" Padding="8,3"
                                    Background="{DynamicResource LegitBrush}" IsHitTestVisible="False"
                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="NEW" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>

                            <Border Style="{StaticResource TagBadge}" Margin="2,2" Padding="8,3"
                                    Background="{DynamicResource OutdatedBrush}"
                                    ToolTip="{Binding LatestVersion, StringFormat='A newer version (v{0}) is available'}"
                                    Visibility="{Binding IsOutdated, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="OUTDATED" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,4,4,0" StrokeThickness="2"
                             Stroke="{DynamicResource SurfaceBrush}"
                             Fill="{Binding IsInstalled, Converter={StaticResource InstalledDotBrushConverter}}"
                             ToolTip="{Binding IsInstalled, Converter={StaticResource InstalledDotTooltipConverter}}" />

                    <Button Style="{StaticResource FavoriteStarButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-2,20,0"
                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Favorite">
                        <Button.Visibility>
                            <MultiBinding Converter="{StaticResource AnyTrueToVisibilityConverter}">
                                <Binding Path="IsMouseOver" ElementName="CardRoot" />
                                <Binding Path="IsFavorite" />
                            </MultiBinding>
                        </Button.Visibility>
                    </Button>

                    <Border Style="{StaticResource SelectionBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                            IsHitTestVisible="False"
                            Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="&#x2713;" FontSize="12" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Border>

                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PluginRowTemplate" DataType="{x:Type vm:PluginDisplayViewModel}">
            <Border x:Name="RowRoot" Style="{StaticResource CardBorder}" Margin="0,4" Padding="10,8" Cursor="Hand"
                    PreviewMouseLeftButtonUp="PluginCard_PreviewMouseLeftButtonUp"
                    PreviewMouseRightButtonDown="PluginCard_PreviewMouseRightButtonDown"
                    Opacity="{Binding IsHidden, Converter={StaticResource HiddenToOpacityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SelectionBadge}" VerticalAlignment="Center" Margin="0,0,10,0"
                            IsHitTestVisible="False"
                            Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="&#x2713;" FontSize="12" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Border>

                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8"
                            Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,12,0">
                        <Grid>
                            <TextBlock Text="&#x1F3B9;" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding LogoPath, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}">
                                <TextBlock.Opacity>
                                    <Binding Path="IsInstalled" Converter="{StaticResource OpacityConverter}" />
                                </TextBlock.Opacity>
                            </TextBlock>
                            <Image Width="40" Height="40" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8" />
                                </Image.Clip>
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource LogoConverter}">
                                        <Binding Path="LogoPath" />
                                        <Binding Path="IsInstalled" />
                                    </MultiBinding>
                                </Image.Source>
                                <Image.Opacity>
                                    <Binding Path="IsInstalled" Converter="{StaticResource OpacityConverter}" />
                                </Image.Opacity>
                            </Image>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <!-- Grid rather than a horizontal StackPanel: the badges must keep their
                             place, and a long name must trim instead of pushing them out of view. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Star-sized so a long name trims instead of pushing the badges
                                     past the right edge; the badges themselves stay Auto. -->
                                <ColumnDefinition Width="3*" MinWidth="60" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <TextBlock Grid.Column="1" Text="{Binding Vendor}" FontSize="13" Margin="8,0,8,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2" Style="{StaticResource TagBadge}" Margin="0,0,8,0" Padding="7,1"
                                    Background="{DynamicResource LegitBrush}" VerticalAlignment="Center"
                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource TagBadge}" Padding="7,1"
                                    Background="{DynamicResource OutdatedBrush}" VerticalAlignment="Center"
                                    ToolTip="{Binding LatestVersion, StringFormat='A newer version (v{0}) is available'}"
                                    Visibility="{Binding IsOutdated, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="OUTDATED" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding InstalledSummaryText}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding InstalledSummaryText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <Button Grid.Column="3" Style="{StaticResource FavoriteStarButton}" VerticalAlignment="Center" Margin="0,0,6,0"
                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Favorite">
                        <Button.Visibility>
                            <MultiBinding Converter="{StaticResource AnyTrueToVisibilityConverter}">
                                <Binding Path="IsMouseOver" ElementName="RowRoot" />
                                <Binding Path="IsFavorite" />
                            </MultiBinding>
                        </Button.Visibility>
                    </Button>

                    <Border Grid.Column="4" Style="{StaticResource TagBadge}" Margin="0,0,10,0" VerticalAlignment="Center"
                            Background="{Binding Tag, Converter={StaticResource TagBrushConverter}}">
                        <TextBlock Text="{Binding Tag, Converter={StaticResource TagTextConverter}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </Border>

                    <Ellipse Grid.Column="5" Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding IsInstalled, Converter={StaticResource InstalledDotBrushConverter}}"
                             ToolTip="{Binding IsInstalled, Converter={StaticResource InstalledDotTooltipConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="PluginCardContainerStyle">
            <Setter Property="FrameworkElement.Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="UIElement.RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="UIElement.RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="10" />
                </Setter.Value>
            </Setter>
            <Setter Property="UIElement.Opacity" Value="0" />
            <Setter Property="FrameworkElement.ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Toggle Favorite"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <TextBlock Text="{Binding PlacementTarget.DataContext.IsFavorite, Converter={StaticResource FavoriteStarGlyphConverter}, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                           Foreground="#FFFBBF24" FontSize="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding PlacementTarget.DataContext.IsHidden, Converter={StaticResource HideMenuTextConverter}, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.ToggleHideCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x1F441;" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Mark Legit"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.MarkLegitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x2714;" Foreground="{DynamicResource LegitBrush}" FontSize="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Mark Cracked"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.MarkCrackedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x2620;" Foreground="{DynamicResource CrackedBrush}" FontSize="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Mark as Instrument"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.MarkAsInstrumentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x1F3B9;" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Mark as Effect"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.MarkAsEffectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x1F39B;" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Fix Metadata..."
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.OpenFixMetadataCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x2699;" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Show in Folder"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <Path Data="M1,3 L6,3 L7.5,4.5 L15,4.5 L15,13 L1,13 Z"
                                      Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="14" Height="12" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Mark as Not a Plugin"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.MarkAsNotAPluginCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x26A0;" Foreground="{DynamicResource CrackedBrush}" FontSize="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Uninstall..."
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.UninstallCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x2716;" Foreground="{DynamicResource CrackedBrush}" FontSize="14" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <!-- Enabled only for remembered (uninstalled) plugins — the inverse of
                             every other item here, which require the plugin to be installed. -->
                        <MenuItem Header="Forget This Plugin"
                                  IsEnabled="{Binding PlacementTarget.DataContext.IsRemembered, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.ForgetPluginCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  ToolTip="Stop remembering this uninstalled plugin's tag, type and versions">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x1F5D1;" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Each container fades and rises into place as it is generated (initial
                     population and when the filtered result set changes). -->
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.26" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" From="10" To="0" Duration="0:0:0.28">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctrl:CustomTitleBar Grid.Row="0" ShowMaximize="True"
                             TitleText="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                             TitleIcon="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Icon}" />

        <Grid Grid.Row="1" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="VST Manager" FontSize="25" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <!-- Library totals: always the whole library, never affected by the search
                     box or filters (unlike the per-tab counts on the toolbar). -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                            ToolTip="Plugins installed on this machine. Plugins you haven't classified yet aren't counted as instruments or effects.">
                    <TextBlock Text="VST Installed:" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding InstalledTotalCount}" FontSize="13" FontWeight="SemiBold" Margin="5,0,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="(" />
                        <Run Text="{Binding InstalledInstrumentCount, Mode=OneWay}" /><Run Text=" instruments, " />
                        <Run Text="{Binding InstalledEffectCount, Mode=OneWay}" /><Run Text=" effects)" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="{Binding CurrentVersion, StringFormat='Version {0}'}" FontSize="13"
                           HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Content="{Binding UpdateButtonText}" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" Padding="8,3" FontSize="12" Margin="0,4,0,0"
                        Foreground="{DynamicResource AccentBrush}"
                        Command="{Binding InstallOrOpenReleaseCommand}"
                        IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource InverseBoolConverter}}"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="{Binding UpdateButtonText}" />
            </StackPanel>
        </DockPanel>

        <WrapPanel x:Name="ToolbarPanel" Grid.Row="1" Margin="0,0,0,10" Orientation="Horizontal">
            <!-- Group: Legit / Cracked management mode -->
            <Border Margin="0,0,14,10" CornerRadius="17"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                    ToolTip="Choose whether to manage your Legit, Cracked, or all plugins">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="Mode" Content="All" Style="{StaticResource ModeSegment}"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:ManagementMode.All}}" />
                    <RadioButton GroupName="Mode" Content="Legit" Tag="&#x2714;" Style="{StaticResource ModeSegment}"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:ManagementMode.Legit}}" />
                    <RadioButton GroupName="Mode" Content="Cracked" Tag="&#x2620;" Style="{StaticResource ModeSegment}"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:ManagementMode.Cracked}}" />
                </StackPanel>
            </Border>

            <!-- Group: Search -->
            <Border Width="280" Margin="0,0,14,10" VerticalAlignment="Center" CornerRadius="18"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1.5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFocused, ElementName=SearchTextBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="13" IsHitTestVisible="False"
                               Margin="14,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchTextBox" Style="{StaticResource MainSearchBoxPlain}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by name, vendor, or path" />

                        <TextBlock Text="Search plugins..." IsHitTestVisible="False"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="2" Style="{StaticResource SearchClearButton}" Margin="0,0,10,0" VerticalAlignment="Center"
                            Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                            Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ToolbarSeparator}" />

            <!-- Group: View controls (Layout, Filter, Select) -->
            <Border Style="{StaticResource ToolbarGroup}" Margin="0,0,14,10">
                <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="8" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Layout" Style="{StaticResource LayoutSegment}"
                                         ToolTip="Grid view"
                                         IsChecked="{Binding LayoutMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:LayoutMode.Grid}}">
                                <TextBlock Text="&#x25A6;" FontSize="16" />
                            </RadioButton>
                            <RadioButton GroupName="Layout" Style="{StaticResource LayoutSegment}"
                                         ToolTip="List view"
                                         IsChecked="{Binding LayoutMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:LayoutMode.List}}">
                                <TextBlock Text="&#x2630;" FontSize="16" />
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <ToggleButton x:Name="FilterToggle" Margin="6,0,0,0"
                                  Style="{StaticResource FilterPopupButton}" ToolTip="Filters" />

                    <Popup PlacementTarget="{Binding ElementName=FilterToggle}"
                           Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=FilterToggle}"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource CardBorder}" Width="260" Margin="0,6,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="Filters" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource GhostButton}"
                                            Padding="8,3" FontSize="12" HorizontalAlignment="Right"
                                            Command="{Binding ResetFiltersCommand}" />
                                </DockPanel>

                                <TextBlock Text="Status" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton Content="All" GroupName="Status" Style="{StaticResource FilterPill}"
                                                 IsChecked="{Binding InstalledFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:InstalledFilterOption.All}}" />
                                    <RadioButton Content="Installed" GroupName="Status" Style="{StaticResource FilterPill}"
                                                 IsChecked="{Binding InstalledFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:InstalledFilterOption.InstalledOnly}}" />
                                    <RadioButton Content="Not Installed" GroupName="Status" Style="{StaticResource FilterPill}"
                                                 IsChecked="{Binding InstalledFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:InstalledFilterOption.NotInstalledOnly}}" />
                                </StackPanel>

                                <TextBlock Text="Format" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton Content="All" GroupName="Format" Style="{StaticResource FilterPill}"
                                                 IsChecked="{Binding FormatFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:FormatFilterOption.All}}" />
                                    <RadioButton Content="VST2" GroupName="Format" Style="{StaticResource FilterPill}"
                                                 IsChecked="{Binding FormatFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:FormatFilterOption.Vst2}}" />
                                    <RadioButton Content="VST3" GroupName="Format" Style="{StaticResource FilterPill}"
                                                 IsChecked="{Binding FormatFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:FormatFilterOption.Vst3}}" />
                                </StackPanel>

                                <CheckBox Content="Show hidden plugins" IsChecked="{Binding ShowHidden}"
                                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ToggleButton Style="{StaticResource GhostToggleButton}" Margin="6,0,0,0"
                                  Padding="12,7" IsChecked="{Binding IsSelectionMode}"
                                  ToolTip="Select multiple plugins to edit at once (Ctrl+Click or Shift+Click also work anytime)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2611;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Select" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ToolbarSeparator}" />

            <!-- Group: Bulk tagging -->
            <Border Style="{StaticResource ToolbarGroup}" Margin="0,0,14,10">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding MarkAllLegitCommand}" ToolTip="Mark all visible installed plugins as Legit">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2713;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Mark All Legit" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Command="{Binding MarkAllCrackedCommand}" ToolTip="Mark all visible installed plugins as Cracked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2620;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Mark All Cracked" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ToolbarSeparator}" />

            <!-- Group: Primary actions -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Style="{StaticResource AccentButton}"
                        Command="{Binding RescanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                        ToolTip="Rescan for installed plugins">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x21BB;" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="RescanSpin" Angle="0" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="SpinStoryboard">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                         From="0" To="360" Duration="0:0:0.8"
                                                                         RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding IsScanning, Converter={StaticResource ScanningLabelConverter}}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource IconButton}" Margin="10,0,0,0"
                        Command="{Binding RefreshAllMetadataCommand}" ToolTip="Refresh all metadata"
                        Content="&#x21BB;" />

                <Button Style="{StaticResource GearButton}" Margin="10,0,0,0"
                        Click="SettingsButton_Click" ToolTip="Settings" />
            </StackPanel>
        </WrapPanel>

        <Border Grid.Row="2" Margin="0,0,0,14" CornerRadius="10" Padding="12,8"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding SelectedCount, Converter={StaticResource CountToVisibilityConverter}}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" />

                <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource GhostButton}"
                        Padding="10,5" FontSize="13" Margin="8,0,0,0"
                        Command="{Binding ClearSelectionCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="13" Margin="8,0,0,0"
                        Command="{Binding BatchMarkEffectCommand}" ToolTip="Set type to Effect for all selected">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F39B;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Effect" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="13" Margin="8,0,0,0"
                        Command="{Binding BatchMarkInstrumentCommand}" ToolTip="Set type to Instrument for all selected">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F3B9;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Instrument" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="13" Margin="8,0,0,0"
                        Command="{Binding BatchMarkCrackedCommand}" ToolTip="Set tag to Cracked for all selected">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2620;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Cracked" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="13" Margin="14,0,0,0"
                        Command="{Binding BatchMarkLegitCommand}" ToolTip="Set tag to Legit for all selected">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2713;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Legit" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3">
            <StackPanel Margin="0,0,0,14"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="True" Height="4" Background="{DynamicResource SurfaceAltBrush}"
                             Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
                <TextBlock Text="Scanning for installed plugins..." FontSize="13" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,14"
                        Visibility="{Binding RefreshProgressText, Converter={StaticResource StringToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="True" Height="4" Background="{DynamicResource SurfaceAltBrush}"
                             Foreground="{DynamicResource OutdatedBrush}" BorderThickness="0" />
                <TextBlock Text="{Binding RefreshProgressText}" FontSize="13" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Border Margin="0,0,0,14" Padding="12,9" CornerRadius="8"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource OutdatedBrush}" BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5"
                    Visibility="{Binding StartupUpdateSummaryText, Converter={StaticResource StringToVisibilityConverter}}">
                <Border.RenderTransform>
                    <TranslateTransform Y="0" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" From="-10" To="0" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,2" Margin="10,0,0,0"
                            Command="{Binding DismissStartupUpdateSummaryCommand}" ToolTip="Dismiss">
                        <TextBlock Text="&#x2715;" FontSize="11" />
                    </Button>
                    <TextBlock VerticalAlignment="Center" FontSize="13">
                        <Run Text="&#x21BB; " Foreground="{DynamicResource OutdatedBrush}" FontWeight="Bold" />
                        <Run Text="{Binding StartupUpdateSummaryText, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Expander IsExpanded="{Binding IsFavoritesSectionExpanded}" Style="{StaticResource SectionExpander}"
                          Margin="0,0,0,16"
                          Visibility="{Binding FavoritesCount, Converter={StaticResource CountToVisibilityConverter}}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2605;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#FFFBBF24" />
                            <TextBlock Text="Favorites" FontWeight="SemiBold" FontSize="17"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FavoritesCount, StringFormat=' ({0})'}" FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding FavoritesView}" ItemTemplate="{StaticResource PluginCardTemplate}"
                                      ItemContainerStyle="{StaticResource PluginCardContainerStyle}"
                                      Visibility="{Binding LayoutMode, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter={x:Static vm:LayoutMode.Grid}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding FavoritesView}" ItemTemplate="{StaticResource PluginRowTemplate}"
                                      ItemContainerStyle="{StaticResource PluginCardContainerStyle}"
                                      Visibility="{Binding LayoutMode, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter={x:Static vm:LayoutMode.List}}" />
                    </Grid>
                </Expander>

                <Expander IsExpanded="{Binding IsInstrumentsSectionExpanded}" Style="{StaticResource SectionExpander}"
                          Visibility="{Binding InstrumentsCount, Converter={StaticResource CountToVisibilityConverter}}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F3B9;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Instruments" FontWeight="SemiBold" FontSize="17"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding InstrumentsCount, StringFormat=' ({0})'}" FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding InstrumentsView}" ItemTemplate="{StaticResource PluginCardTemplate}"
                                      ItemContainerStyle="{StaticResource PluginCardContainerStyle}"
                                      Visibility="{Binding LayoutMode, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter={x:Static vm:LayoutMode.Grid}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding InstrumentsView}" ItemTemplate="{StaticResource PluginRowTemplate}"
                                      ItemContainerStyle="{StaticResource PluginCardContainerStyle}"
                                      Visibility="{Binding LayoutMode, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter={x:Static vm:LayoutMode.List}}" />
                    </Grid>
                </Expander>

                <Expander IsExpanded="{Binding IsEffectsSectionExpanded}" Style="{StaticResource SectionExpander}"
                          Margin="0,16,0,0"
                          Visibility="{Binding EffectsCount, Converter={StaticResource CountToVisibilityConverter}}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F39B;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Effects" FontWeight="SemiBold" FontSize="17"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EffectsCount, StringFormat=' ({0})'}" FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding EffectsView}" ItemTemplate="{StaticResource PluginCardTemplate}"
                                      ItemContainerStyle="{StaticResource PluginCardContainerStyle}"
                                      Visibility="{Binding LayoutMode, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter={x:Static vm:LayoutMode.Grid}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding EffectsView}" ItemTemplate="{StaticResource PluginRowTemplate}"
                                      ItemContainerStyle="{StaticResource PluginCardContainerStyle}"
                                      Visibility="{Binding LayoutMode, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter={x:Static vm:LayoutMode.List}}" />
                    </Grid>
                </Expander>

                <Expander IsExpanded="{Binding IsUnclassifiedSectionExpanded}" Style="{StaticResource SectionExpander}"
                          Margin="0,16,0,0"
                          Visibility="{Binding UnclassifiedCount, Converter={StaticResource CountToVisibilityConverter}}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource UnclassifiedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Unclassified" FontWeight="SemiBold" FontSize="17"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UnclassifiedCount, StringFormat=' ({0})'}" FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding UnclassifiedView}" ItemTemplate="{StaticResource PluginCardTemplate}"
                                      ItemContainerStyle="{StaticResource PluginCardContainerStyle}"
                                      Visibility="{Binding LayoutMode, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter={x:Static vm:LayoutMode.Grid}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding UnclassifiedView}" ItemTemplate="{StaticResource PluginRowTemplate}"
                                      ItemContainerStyle="{StaticResource PluginCardContainerStyle}"
                                      Visibility="{Binding LayoutMode, Converter={StaticResource EnumEqualsToVisibilityConverter}, ConverterParameter={x:Static vm:LayoutMode.List}}" />
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</Window>
