<Application
    x:Class="VstManager.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:VstManager.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Palette.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:PathToImageConverter x:Key="PathToImage" />
            <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:TagSummaryToBrushConverter x:Key="TagSummaryToBrush" />
            <conv:TagSummaryToTextConverter x:Key="TagSummaryToText" />
            <conv:FavoriteGlyphConverter x:Key="FavoriteGlyph" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
