<Window x:Class="VstManager.App.Views.ClassifyPluginsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ctrl="clr-namespace:VstManager.App.Controls"
        mc:Ignorable="d"
        Title="Classify Plugins" Height="560" Width="520"
        MinHeight="360" MinWidth="440"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource ChromedWindowResizableWithGrip}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctrl:CustomTitleBar Grid.Row="0" ShowMaximize="False"
                             TitleText="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                             TitleIcon="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Icon}" />

    <Grid Grid.Row="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Multiple versions found" FontSize="21" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="These plugins have more than one installed copy. Mark which copy is the legit one and which is the cracked one (leave blank to decide later)." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Plugins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Vendor}" FontSize="13" Margin="0,1,0,10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding Vendor, Converter={StaticResource StringToVisibilityConverter}}" />

                                <ItemsControl ItemsSource="{Binding Copies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FormatLabel}" FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="260"
                                                               HorizontalAlignment="Left" />
                                                </StackPanel>

                                                <ToggleButton Grid.Column="1" Content="Legit" Margin="0,0,8,0"
                                                              Style="{StaticResource GhostToggleButton}" Padding="12,6"
                                                              IsChecked="{Binding IsLegit, Mode=TwoWay}" />
                                                <ToggleButton Grid.Column="2" Content="Cracked"
                                                              Style="{StaticResource GhostToggleButton}" Padding="12,6"
                                                              IsChecked="{Binding IsCracked, Mode=TwoWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Decide Later" Style="{StaticResource GhostButton}" Click="Later_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Save_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2713;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Save" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
    </Grid>
</Window>
