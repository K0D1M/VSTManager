<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Content Include="a_clean_modern_app_icon_logo_design_on_a_dark_b.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\Downloads\logo_package\a_clean_modern_app_icon_logo_design_on_a_dark_b.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VstManager.Core\VstManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms below only supplies System.Drawing.Icon for the tray icon; its implicit
         global usings collide with WPF's own System.Windows / System.Windows.Forms-adjacent
         types (Color, Application, DragEventArgs, ...), so drop them and qualify explicitly
         wherever System.Drawing is actually needed. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>True</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.5.1</Version>
    <ApplicationIcon>a_clean_modern_app_icon_logo_design_on_a_dark_b.ico</ApplicationIcon>
    <SignAssembly>False</SignAssembly>
    <Company>$(K0D1M)</Company>
    <Product>$(KD Manager for VST)</Product>
    <PackageIcon>a_clean_modern_app_icon_logo_design_on_a_dark_b.png</PackageIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Authors>$(K0D1M)</Authors>
    <PackageId>$(KDManagerForVST)</PackageId>
    <UseWindowsForms>True</UseWindowsForms>
    <Platforms>AnyCPU;ARM64</Platforms>
  </PropertyGroup>

</Project>
