<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- MEGA S4 is S3-compatible, so the stock AWS SDK talks to it with a custom ServiceURL. -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.413" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="catalog.json" />
    <EmbeddedResource Include="excluded-files.json" />
  </ItemGroup>

</Project>
