<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The colour values carry over verbatim from the WPF head's Dark.xaml / Light.xaml — the only
        XAML in that project that ports at all. Everything else here is new: WinUI expresses
        theming through ThemeDictionaries + ThemeResource rather than swapping merged dictionaries
        at runtime, so light/dark is declarative and the framework handles the switch.

        Surfaces stay solid for legibility on a dense plugin grid; gradients are reserved for accent
        surfaces (selected nav item, primary buttons, tag chips, card hover) where they read as
        deliberate rather than as noise behind text.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SurfaceColor">#FF1C1C24</Color>
            <Color x:Key="SurfaceAltColor">#FF25252F</Color>
            <Color x:Key="BorderColor">#FF32323E</Color>
            <Color x:Key="TextPrimaryColor">#FFEDEDF2</Color>
            <Color x:Key="TextSecondaryColor">#FFA0A0AE</Color>
            <Color x:Key="AccentColor">#FF8A5CF6</Color>
            <Color x:Key="AccentHoverColor">#FF9D74F8</Color>
            <Color x:Key="LegitColor">#FF34D399</Color>
            <Color x:Key="CrackedColor">#FFF87171</Color>
            <Color x:Key="UnclassifiedColor">#FF64748B</Color>
            <Color x:Key="OutdatedColor">#FFF59E0B</Color>

            <!-- Cards sit *over* Mica, so they are deliberately translucent: the desktop tint shows
                 through just enough to feel layered, while staying opaque enough to read on. -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF1C1C24" Opacity="0.72" />
            <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#FF25252F" Opacity="0.92" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#FF32323E" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1C1C24" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF25252F" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFEDEDF2" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA0A0AE" />
            <SolidColorBrush x:Key="LegitBrush" Color="#FF34D399" />
            <SolidColorBrush x:Key="CrackedBrush" Color="#FFF87171" />
            <SolidColorBrush x:Key="OutdatedBrush" Color="#FFF59E0B" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="SurfaceAltColor">#FFEDEDF5</Color>
            <Color x:Key="BorderColor">#FFDCDCE6</Color>
            <Color x:Key="TextPrimaryColor">#FF1B1B23</Color>
            <Color x:Key="TextSecondaryColor">#FF6B6B7A</Color>
            <Color x:Key="AccentColor">#FF6D28D9</Color>
            <Color x:Key="AccentHoverColor">#FF7C3AED</Color>
            <Color x:Key="LegitColor">#FF059669</Color>
            <Color x:Key="CrackedColor">#FFDC2626</Color>
            <Color x:Key="UnclassifiedColor">#FF64748B</Color>
            <Color x:Key="OutdatedColor">#FFD97706</Color>

            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" Opacity="0.78" />
            <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#FFFFFFFF" Opacity="0.96" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#FFDCDCE6" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFEDEDF5" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1B1B23" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF6B6B7A" />
            <SolidColorBrush x:Key="LegitBrush" Color="#FF059669" />
            <SolidColorBrush x:Key="CrackedBrush" Color="#FFDC2626" />
            <SolidColorBrush x:Key="OutdatedBrush" Color="#FFD97706" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Gradient accents. Diagonal accent → hover shade, the same pair the WPF head uses for its
         flat accent, so the two apps read as the same product. -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{ThemeResource AccentColor}" Offset="0" />
        <GradientStop Color="{ThemeResource AccentHoverColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- Sits behind a hovered card: mostly transparent so it reads as a glow rather than a fill. -->
    <LinearGradientBrush x:Key="CardGlowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{ThemeResource AccentColor}" Offset="0" />
        <GradientStop Color="Transparent" Offset="0.85" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{ThemeResource AccentColor}" Offset="0" />
        <GradientStop Color="{ThemeResource AccentHoverColor}" Offset="0.5" />
        <GradientStop Color="Transparent" Offset="1" />
    </LinearGradientBrush>

    <x:Double x:Key="CardWidth">190</x:Double>
    <x:Double x:Key="CardLogoSize">72</x:Double>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

</ResourceDictionary>

