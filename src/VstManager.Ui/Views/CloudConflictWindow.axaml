<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VstManager.Ui.Views.CloudConflictWindow"
        Title="Cloud Sync Conflict"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundGradient}">

    <StackPanel Margin="26,22,26,22" Spacing="16">

        <StackPanel Spacing="4">
            <TextBlock Classes="sectionHeader" Text="Both copies changed" />
            <TextBlock Classes="subtitle" TextWrapping="Wrap"
                       Text="This machine and the cloud copy have both been edited since the last sync. Keeping one discards the other's changes." />
        </StackPanel>

        <!-- The two cards ARE the choice now — clicking "This machine" resolves KeepLocal,
             clicking "Cloud copy" resolves KeepRemote. No default/accent styling on either: which
             one you lose is permanent, so nothing should look like the "recommended" pick. -->
        <StackPanel Spacing="10">
            <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="14" Click="KeepLocal_Click"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLarge}">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="tabIcon" Data="{StaticResource IconComputer}" />
                        <TextBlock Text="This machine" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="LocalTimestampText" Classes="meta" />
                </StackPanel>
            </Button>

            <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="14" Click="KeepRemote_Click"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLarge}">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="tabIcon" Data="{StaticResource CloudGlyph}" />
                        <TextBlock Text="Cloud copy" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="RemoteTimestampText" Classes="meta" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Button Classes="ghost" HorizontalAlignment="Right" Padding="14,9" Click="DecideLater_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="✕" VerticalAlignment="Center" />
                <TextBlock Text="Decide Later" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</Window>
