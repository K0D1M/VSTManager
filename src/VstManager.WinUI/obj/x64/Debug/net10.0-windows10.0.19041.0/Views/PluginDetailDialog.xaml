<ContentDialog x:ConnectionId='1'
    x:Class="VstManager.WinUI.Views.PluginDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:core="using:VstManager.Core.Models"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ScrollViewer MaxHeight="520">
        <StackPanel Spacing="18" Width="440">

            <!-- Identity -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="76" Height="76" CornerRadius="12"
                        Background="{ThemeResource SurfaceAltBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xEC4F;" FontSize="26"
                                  Foreground="{ThemeResource TextSecondaryBrush}" />
                        <Image x:ConnectionId='19' Stretch="UniformToFill"
                                                                                                                      />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:ConnectionId='13'                             FontSize="21" FontWeight="Bold"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:ConnectionId='14'                                      FontSize="13"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,4,0,0">
                        <Border x:ConnectionId='15' CornerRadius="9" Padding="8,2"
                                                                                                                           >
                            <TextBlock x:ConnectionId='18'                                                                                     
                                       FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <Border x:ConnectionId='16' CornerRadius="9" Padding="8,2" Background="{ThemeResource SurfaceAltBrush}"
                                                                                                                                             >
                            <TextBlock x:ConnectionId='17'                                                          FontSize="10"
                                       FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Versions -->
            <Border CornerRadius="10" Padding="14" Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Installed" FontSize="11"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:ConnectionId='12'                                                                  
                                   FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Latest available" FontSize="11"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:ConnectionId='11'                                                                 
                                   FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tags -->
            <StackPanel x:ConnectionId='2' Spacing="8"
                                                                                                  >
                <TextBlock Text="Tags" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <muxc:ItemsRepeater x:ConnectionId='7'                                   >
                    <muxc:ItemsRepeater.Layout>
                        <muxc:UniformGridLayout Orientation="Horizontal" MinItemWidth="0"
                                                MinColumnSpacing="6" MinRowSpacing="6" />
                    </muxc:ItemsRepeater.Layout>
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate                                >
                            <Border x:ConnectionId='9' CornerRadius="10" Padding="10,3"
                                                                                                         >
                                <TextBlock x:ConnectionId='10'                      FontSize="11" FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>
            </StackPanel>

            <!-- Install locations -->
            <StackPanel Spacing="8">
                <TextBlock Text="Install locations" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <ItemsControl x:ConnectionId='3'                                             >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate                             >
                            <Border x:ConnectionId='5' CornerRadius="8" Padding="10,7" Margin="0,0,0,5"
                                    Background="{ThemeResource SurfaceAltBrush}">
                                <TextBlock x:ConnectionId='6'                      FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                                                                  />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

