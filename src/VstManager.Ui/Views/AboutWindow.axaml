<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VstManager.Ui.ViewModels"
        xmlns:conv="using:VstManager.Ui.Converters"
        x:Class="VstManager.Ui.Views.AboutWindow"
        x:DataType="vm:SettingsViewModel"
        Title="About VST Manager"
        Width="480" Height="640"
        MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundGradient}">

    <Window.Resources>
        <conv:LastCheckedConverter x:Key="LastChecked" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Styles>

    <!-- Moved out of Settings (it was the last tab) into its own window, opened from the bottom
         of the main sidebar. Binds the same SettingsViewModel, so the update check, its status
         and the version all come from the one place they always did. -->
    <Grid RowDefinitions="*,Auto" Margin="20,18,20,16">
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="0,0,4,0">

                <Border Classes="section">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <Image Source="avares://VstManager.Ui/Assets/app-icon.ico" Width="64" Height="64" />
                        <TextBlock Text="VST Manager" Classes="sectionHeader"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                                   Classes="subtitle" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Classes="section">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="label" Text="Updates" />
                                <TextBlock Classes="meta"
                                           Text="{Binding LastUpdateCheck, Converter={StaticResource LastChecked}}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Padding="12,6" FontSize="13"
                                    Content="Check Now"
                                    Command="{Binding CheckForAppUpdateCommand}"
                                    IsEnabled="{Binding !IsCheckingForAppUpdate}" />
                        </Grid>

                        <TextBlock Classes="meta" TextWrapping="Wrap"
                                   Text="{Binding UpdateStatusText}"
                                   IsVisible="{Binding UpdateStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <Button Classes="accent" HorizontalAlignment="Left" Padding="14,7"
                                Content="{Binding UpdateButtonText}"
                                Click="UpdateNow_Click"
                                IsEnabled="{Binding !IsInstallingUpdate}"
                                IsVisible="{Binding IsUpdateAvailable}" />
                    </StackPanel>
                </Border>

                <Border Classes="section">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Vibe-coded with ❤️ by" Classes="meta" />
                            <TextBlock Text="K0D1M" Classes="meta" Cursor="Hand"
                                       Foreground="{DynamicResource AccentBrush}"
                                       PointerPressed="AuthorLink_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Source on" Classes="meta" />
                            <TextBlock Text="GitHub" Classes="meta" Cursor="Hand"
                                       Foreground="{DynamicResource AccentBrush}"
                                       PointerPressed="RepoLink_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- GPLv3 asks interactive programs to show a no-warranty notice and where the
                     licence is; no link out, so nothing here can 404 once the app is bundled. -->
                <Border Classes="section">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Legal" />
                        <TextBlock Classes="meta" TextWrapping="Wrap"
                                   Text="Licensed under the GNU General Public License v3.0." />
                        <TextBlock Classes="meta" TextWrapping="Wrap"
                                   Text="This program comes with ABSOLUTELY NO WARRANTY. This is free software, and you are welcome to redistribute it under certain conditions — see the LICENSE file in the project's source for the full terms." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Classes="accent" Content="Close" Padding="22,8" Margin="0,14,0,0"
                HorizontalAlignment="Right" Click="Close_Click" />
    </Grid>
</Window>
