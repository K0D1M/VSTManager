<Page x:ConnectionId='1'
    x:Class="VstManager.WinUI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:VstManager.WinUI.ViewModels"
    xmlns:ctrl="using:VstManager.WinUI.Controls"
    xmlns:core="using:VstManager.Core.Models"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Page.Resources>
        <CollectionViewSource x:ConnectionId='2' x:Name="GroupedPlugins" IsSourceGrouped="True" />

        <!-- One plugin card. WinUI states (PointerOver etc.) come from the GridViewItem template,
             so the hover glow is driven by VisualStateManager rather than WPF triggers. -->
        <DataTemplate x:Key="PluginCardTemplate"                                       >
            <!-- Height fits the worst case: a two-line name plus three tag chips wrapping onto two
                 rows. Too short and the bottom-aligned block in row 3 overflows upward and draws
                 over the vendor line. -->
            <Grid x:ConnectionId='4' Width="188" Height="258" Padding="14" CornerRadius="12"
                  Background="{ThemeResource CardBackgroundBrush}"
                  BorderBrush="{ThemeResource CardBorderBrush}"
                  BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Artwork -->
                <Border Grid.Row="0" Width="64" Height="64" CornerRadius="10"
                        HorizontalAlignment="Center" Margin="0,0,0,10"
                        Background="{ThemeResource SurfaceAltBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xEC4F;" FontSize="26"
                                  Foreground="{ThemeResource TextSecondaryBrush}" />
                        <Image x:ConnectionId='17' Stretch="UniformToFill"
                                                                                                                    
                                                                                                               />
                    </Grid>
                </Border>

                <TextBlock x:ConnectionId='5' Grid.Row="1"                      FontWeight="SemiBold" FontSize="14"
                           TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextPrimaryBrush}" />

                <TextBlock x:ConnectionId='6' Grid.Row="2"                               FontSize="12"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           Foreground="{ThemeResource TextSecondaryBrush}" />

                <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Spacing="6">
                    <TextBlock x:ConnectionId='9'                                                   FontSize="11"
                               TextAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}"
                                                                                                                                      />

                    <!-- Status + type chips -->
                    <ItemsControl x:ConnectionId='10'                                                
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctrl:WrapPanel HorizontalSpacing="4" VerticalSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                                >
                                <Border x:ConnectionId='15' CornerRadius="9" Padding="7,2"
                                                                                                             >
                                    <TextBlock x:ConnectionId='16'                      FontSize="10" FontWeight="SemiBold"
                                               Foreground="White" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <Border x:ConnectionId='11' CornerRadius="9" Padding="8,2"
                                                                                                                    >
                            <TextBlock x:ConnectionId='13'                                                                              
                                       FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <Border x:ConnectionId='12' CornerRadius="9" Padding="8,2"
                                Background="{ThemeResource OutdatedBrush}"
                                                                                                                          >
                            <TextBlock Text="UPDATE" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Favourite, top-right -->
                <Button x:ConnectionId='7' Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Padding="4"
                                                             
                        ToolTipService.ToolTip="Toggle favourite">
                    <FontIcon x:ConnectionId='8' FontSize="14"
                                                                                                                
                              Foreground="#FFFBBF24" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,8,24,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: gradient accent bar + title + live summary -->
        <Grid Grid.Row="0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="4" CornerRadius="2"
                    Background="{StaticResource AccentGradientBrush}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Library" FontSize="30" FontWeight="Bold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock x:ConnectionId='33'                                                    FontSize="13"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Command bar: search, filter, sort -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:ConnectionId='24' Grid.Column="0" MaxWidth="380" HorizontalAlignment="Left"
                            PlaceholderText="Search plugins, vendors, tags…"
                            QueryIcon="Find"
                                                                                                                   />

            <DropDownButton Grid.Column="1" Content="Filter">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem x:ConnectionId='29' Text="All" GroupName="filter" IsChecked="True"                      Tag="All" />
                        <RadioMenuFlyoutItem x:ConnectionId='30' Text="Installed" GroupName="filter"                      Tag="Installed" />
                        <RadioMenuFlyoutItem x:ConnectionId='31' Text="Updates available" GroupName="filter"                      Tag="Outdated" />
                        <RadioMenuFlyoutItem x:ConnectionId='32' Text="Favorites" GroupName="filter"                      Tag="Favorites" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <DropDownButton Grid.Column="2" Content="Sort">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem x:ConnectionId='25' Text="Name" GroupName="sort" IsChecked="True"                    Tag="Name" />
                        <RadioMenuFlyoutItem x:ConnectionId='26' Text="Vendor" GroupName="sort"                    Tag="Vendor" />
                        <RadioMenuFlyoutItem x:ConnectionId='27' Text="Type" GroupName="sort"                    Tag="Type" />
                        <RadioMenuFlyoutItem x:ConnectionId='28' Text="Update status" GroupName="sort"                    Tag="UpdateStatus" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <muxc:ProgressRing x:ConnectionId='18' Grid.Row="2" IsActive="True" Width="40" Height="40"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                                                                               />

        <!-- Grouped card grid with sticky section headers -->
        <GridView x:ConnectionId='19' x:Name="PluginGrid"
                  Grid.Row="2"
                                                                         
                  ItemTemplate="{StaticResource PluginCardTemplate}"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                                                  
                  Padding="0,0,0,24"
                                                                                                                                                 >
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate                            >
                            <StackPanel x:ConnectionId='21' Orientation="Horizontal" Spacing="10" Margin="0,10,0,12">
                                <TextBlock x:ConnectionId='22'                      FontSize="19" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                        Background="{ThemeResource SurfaceAltBrush}">
                                    <TextBlock x:ConnectionId='23'                           FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
        </GridView>
    </Grid>
</Page>

