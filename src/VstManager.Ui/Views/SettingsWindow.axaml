<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VstManager.Ui.ViewModels"
        xmlns:model="using:VstManager.Core.Models"
        xmlns:conv="using:VstManager.Ui.Converters"
        x:Class="VstManager.Ui.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="720" Height="620"
        MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundGradient}">

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="20,18,20,16">

        <TabControl Grid.Row="0">

            <!-- General ....................................................... -->
            <TabItem Header="General">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,10,4,0">

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionHeader" Text="Startup" />
                            <TextBlock Classes="subtitle"
                                       Text="Whether VST Manager starts on its own when you sign in." />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <CheckBox Content="Launch VST Manager at login"
                                      IsChecked="{Binding AutostartEnabled}" />
                            <TextBlock Classes="meta" Margin="26,0,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource CrackedBrush}"
                                       IsVisible="{Binding HasAutostartError}"
                                       Text="{Binding AutostartError}" />
                        </StackPanel>

                        <Separator Margin="0,4" />

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionHeader" Text="Notifications" />
                            <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                       Text="A brief message in the corner of the window when a scan or metadata refresh finishes." />
                        </StackPanel>

                        <CheckBox Content="Show notifications"
                                  IsChecked="{Binding ShowNotifications}" />

                        <Separator Margin="0,4" />

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionHeader" Text="Closing the window" />
                            <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                       Text="Keep VST Manager running in the background when the window is closed. Reopen it from the tray icon, which also has an Exit option." />
                        </StackPanel>

                        <CheckBox Content="Keep running in the tray when the window is closed"
                                  IsChecked="{Binding MinimizeToTray}" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Appearance .................................................... -->
            <TabItem Header="Appearance">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,10,4,0">

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionHeader" Text="Theme" />
                            <TextBlock Classes="subtitle"
                                       Text="System follows your operating system and keeps following it as it changes." />
                        </StackPanel>
                        <Border Classes="section">
                            <Border Classes="segmentGroup" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Classes="segment plain" GroupName="theme" Content="System"
                                                 IsChecked="{Binding IsSystemTheme}" />
                                    <RadioButton Classes="segment plain" GroupName="theme" Content="Light"
                                                 IsChecked="{Binding IsLightTheme}" />
                                    <RadioButton Classes="segment plain" GroupName="theme" Content="Dark"
                                                 IsChecked="{Binding IsDarkTheme}" />
                                </StackPanel>
                            </Border>
                        </Border>

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionHeader" Text="Accent Colour" />
                            <TextBlock Classes="subtitle" Text="Used for highlights, selection and buttons." />
                        </StackPanel>
                        <Border Classes="section">
                            <ItemsControl ItemsSource="{Binding AccentSwatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Width="34" Height="34" Padding="0" Cursor="Hand"
                                                Background="{Binding Converter={StaticResource HexToBrush}}"
                                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).SetAccentCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate>
                                                    <Border CornerRadius="{DynamicResource RadiusMedium}"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{DynamicResource BorderBrush2}"
                                                            BorderThickness="1" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Scanning ..................................................... -->
            <TabItem Header="Scanning">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,10,4,0">

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionHeader" Text="Extra Folders" />
                            <TextBlock Classes="subtitle"
                                       Text="Searched in addition to the standard plugin locations below." />
                        </StackPanel>
                        <Border Classes="section">
                            <StackPanel Spacing="10">
                                <Button Classes="accent" HorizontalAlignment="Left" Padding="14,7"
                                        Content="Add Folder…" Click="AddFolder_Click" />

                                <TextBlock Classes="meta" Text="No extra folders added."
                                           IsVisible="{Binding !ScanFolders.Count}" />

                                <ItemsControl ItemsSource="{Binding ScanFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                <TextBlock Grid.Column="0" Classes="meta" Text="{Binding}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding}" />
                                                <Button Grid.Column="1" Classes="ghost" Padding="8,4" Margin="8,0,0,0"
                                                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveScanFolderCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Stop scanning this folder">
                                                    <TextBlock Text="✕" Foreground="{DynamicResource CrackedBrush}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionHeader" Text="Standard Locations" />
                            <TextBlock Classes="subtitle" Text="Always scanned. These cannot be removed." />
                        </StackPanel>
                        <Border Classes="section">
                            <ItemsControl ItemsSource="{Binding DefaultScanFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="meta" Text="{Binding}" Margin="0,0,0,4"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tags ......................................................... -->
            <TabItem Header="Tags">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,10,4,0">

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionHeader" Text="New Tag" />
                            <TextBlock Classes="subtitle"
                                       Text="Tags are applied from a plugin's detail window." />
                        </StackPanel>
                        <Border Classes="section">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,10,140,10,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="label" Text="Name" />
                                        <TextBox Classes="search" Text="{Binding NewTagName}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="label" Text="Colour" />
                                        <TextBox Classes="search" Text="{Binding NewTagColor}"
                                                 FontFamily="Consolas" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Classes="accent" Content="Add Tag"
                                            Padding="16,7" VerticalAlignment="Bottom"
                                            Command="{Binding AddTagCommand}" />
                                </Grid>
                                <TextBlock Classes="meta" Text="{Binding TagStatus}"
                                           IsVisible="{Binding HasTagStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionHeader" Text="All Tags" />
                            <TextBlock Classes="subtitle"
                                       Text="Built-in tags can't be deleted — automatic detection relies on them." />
                        </StackPanel>
                        <Border Classes="section">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="model:TagDefinition">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,7">
                                            <Border Grid.Column="0" Width="11" Height="11" CornerRadius="5.5"
                                                    VerticalAlignment="Center" Margin="0,0,10,0"
                                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center"
                                                    IsVisible="{Binding IsPreset}">
                                                <TextBlock Text="built-in" />
                                            </Border>
                                            <Button Grid.Column="3" Classes="ghost" Padding="8,4" Margin="8,0,0,0"
                                                    IsVisible="{Binding !IsPreset}"
                                                    Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).DeleteTagCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Delete this tag and remove it from every plugin">
                                                <TextBlock Text="✕" Foreground="{DynamicResource CrackedBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Cloud ........................................................ -->
            <TabItem Header="Cloud">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,10,4,0">

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionHeader" Text="Cloud Sync" />
                            <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                       Text="Mirrors your classifications, tags and corrections so another machine running VST Manager sees the same library." />
                        </StackPanel>
                        <Border Classes="section">
                            <StackPanel Spacing="12">
                                <CheckBox Content="Keep this machine in sync"
                                          IsChecked="{Binding CloudSyncEnabled}"
                                          Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Classes="meta" TextWrapping="Wrap"
                                           Text="{Binding CloudStatusMessage}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="accent" Content="Sync Now" Padding="16,7"
                                            Command="{Binding SyncNowCommand}"
                                            IsEnabled="{Binding CloudSyncEnabled}" />
                                    <Button Classes="ghost" Content="Upload" Padding="16,7"
                                            Command="{Binding UploadCommand}"
                                            IsEnabled="{Binding CloudSyncEnabled}"
                                            ToolTip.Tip="Overwrite the cloud copy with this machine's" />
                                    <Button Classes="ghost" Content="Restore" Padding="16,7"
                                            Click="Restore_Click"
                                            IsEnabled="{Binding CloudSyncEnabled}"
                                            ToolTip.Tip="Overwrite this machine with the cloud copy" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionHeader" Text="Pairing" />
                            <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                       Text="Machines sharing a sync id share a library. Copy this id to your other machine to pair them." />
                        </StackPanel>
                        <Border Classes="section">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" Text="This machine's sync id" />
                                    <SelectableTextBlock Text="{Binding CloudDeviceId}"
                                                         FontFamily="Consolas" TextWrapping="Wrap"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" Text="Use a different sync id" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Classes="search" FontFamily="Consolas"
                                                 Watermark="Paste the id from your other machine"
                                                 Text="{Binding DeviceIdInput}" />
                                        <Button Grid.Column="1" Classes="ghost" Content="Apply"
                                                Padding="16,7" Margin="8,0,0,0"
                                                Command="{Binding ApplyDeviceIdCommand}" />
                                    </Grid>
                                    <TextBlock Classes="meta" TextWrapping="Wrap"
                                               Text="Changing this needs a restart before the next sync uses it." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Data ......................................................... -->
            <TabItem Header="Data">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,10,4,0">

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionHeader" Text="Backup and Restore" />
                            <TextBlock Classes="subtitle"
                                       Text="Carries your classifications, tags, corrections and scan folders to another machine." />
                        </StackPanel>
                        <Border Classes="section">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="accent" Content="Export…" Padding="16,7"
                                            Click="Export_Click" />
                                    <Button Classes="ghost" Content="Import…" Padding="16,7"
                                            Click="Import_Click" />
                                </StackPanel>
                                <TextBlock Classes="meta" TextWrapping="Wrap"
                                           Text="{Binding DataStatus}"
                                           IsVisible="{Binding HasDataStatus}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="section">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="Importing replaces what's here" />
                                <TextBlock Classes="meta" TextWrapping="Wrap"
                                           Text="An import overwrites your current library, tags and corrections with the contents of the file. Export first if you want to keep them." />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <TextBlock Grid.Column="0" Classes="meta" VerticalAlignment="Center"
                       Text="Changes are saved as you make them." />
            <Button Grid.Column="1" Classes="accent" Content="Close" Padding="22,8" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
