<Window x:Class="VstManager.App.Views.PluginDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:core="clr-namespace:VstManager.Core.Models;assembly=VstManager.Core"
        mc:Ignorable="d"
        Title="{Binding Name}" Width="440"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Icon>
        <MultiBinding Converter="{StaticResource LogoConverter}">
            <Binding Path="LogoPath" />
            <Binding Path="IsInstalled" />
        </MultiBinding>
    </Window.Icon>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="200" ClipToBounds="True">
            <Grid>
                <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource LogoConverter}">
                            <Binding Path="LogoPath" />
                            <Binding Path="IsInstalled" />
                        </MultiBinding>
                    </Image.Source>
                </Image>
                <TextBlock Text="&#x1F3B9;" FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding LogoPath, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" />
            </Grid>

            <Rectangle VerticalAlignment="Bottom" Height="110">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#FFFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                    Width="30" Height="30" Style="{StaticResource GhostButton}" Padding="0"
                    Click="Close_Click" ToolTip="Close">
                <TextBlock Text="&#x2715;" FontSize="14" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,0">
            <StackPanel Margin="0,4,0,0">
                <TextBlock Text="Fix Metadata" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource SearchBox}" Margin="0,0,0,12"
                         Text="{Binding Form.Name, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Vendor" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource SearchBox}" Margin="0,0,0,10"
                         Text="{Binding Form.Vendor, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />

                <DockPanel Margin="0,0,0,16" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="10,6" FontSize="13"
                            Click="AutoDetect_Click" ToolTip="Try to auto-fill Name, Vendor, and Current Version from the catalog and this machine">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2728;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Auto-Detect" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Form.AutoDetectStatusText, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Style="{StaticResource TagBadge}" Margin="0,0,8,0"
                            Background="{Binding Tag, Converter={StaticResource TagBrushConverter}}">
                        <TextBlock Text="{Binding Tag, Converter={StaticResource TagTextConverter}}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <Border Style="{StaticResource TagBadge}" Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                            Visibility="{Binding InstalledFormatsText, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding InstalledFormatsText}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Type" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <Border CornerRadius="17" Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Kind" Content="Instrument" Tag="&#x1F3B9;" Style="{StaticResource ModeSegment}"
                                         IsEnabled="{Binding IsInstalled}"
                                         IsChecked="{Binding Form.Kind, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static core:PluginKind.Instrument}}"
                                         Checked="InstrumentRadio_Checked" />
                            <RadioButton GroupName="Kind" Content="Effect" Tag="&#x1F39B;" Style="{StaticResource ModeSegment}"
                                         IsEnabled="{Binding IsInstalled}"
                                         IsChecked="{Binding Form.Kind, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static core:PluginKind.Effect}}"
                                         Checked="EffectRadio_Checked" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <Border CornerRadius="17" Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Status" Content="Legit" Tag="&#x2714;" Style="{StaticResource ModeSegment}"
                                         IsEnabled="{Binding IsInstalled}"
                                         IsChecked="{Binding Form.SelectedTag, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static core:PluginTag.Legit}}"
                                         Checked="LegitRadio_Checked" />
                            <RadioButton GroupName="Status" Content="Cracked" Tag="&#x2620;" Style="{StaticResource ModeSegment}"
                                         IsEnabled="{Binding IsInstalled}"
                                         IsChecked="{Binding Form.SelectedTag, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static core:PluginTag.Cracked}}"
                                         Checked="CrackedRadio_Checked" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Current Version" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="CurrentVersionBox" Style="{StaticResource SearchBox}"
                             Text="{Binding Form.CurrentVersion, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsInstalled}" Margin="0,0,0,14" />

                    <TextBlock Text="Latest Available" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="LatestVersionBox" Style="{StaticResource SearchBox}"
                             Text="{Binding Form.LatestVersion, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsInstalled}" />
                </StackPanel>

                <TextBlock Text="Logo" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="10,6" FontSize="13" Click="SearchKvr_Click"
                            ToolTip="Search KVR Audio's product database">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F50D;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Search KVR Audio" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Padding="10,6" FontSize="13" Click="SearchWeb_Click"
                            ToolTip="Search Google Images">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F310;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Search the Web" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" MinHeight="120">
                    <Grid>
                        <TextBlock x:Name="LogoPlaceholderText" Text="Paste an image URL below and click Preview"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                        <Image x:Name="LogoPreviewImage" Stretch="Uniform" MaxHeight="150" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Preview" Style="{StaticResource GhostButton}"
                            Padding="12,7" Margin="8,0,0,0" Click="PreviewLogo_Click" />
                    <TextBox x:Name="LogoUrlTextBox" Style="{StaticResource SearchBox}"
                             Text="{Binding Form.LogoUrl, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="LogoUrlTextBox_TextChanged" />
                </DockPanel>
                <TextBlock FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Form.LogoStatusText, RelativeSource={RelativeSource AncestorType=Window}}" />

                <TextBlock Text="Not installed on this machine" FontSize="13" Margin="0,0,0,0"
                           Foreground="{DynamicResource CrackedBrush}"
                           Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                <TextBlock Text="{Binding Path}" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource GhostButton}"
                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="MarkAsNotAPlugin_Click"
                            ToolTip="Excludes this file by name from future scans, on this and any other machine">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x26A0;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource CrackedBrush}" />
                            <TextBlock Text="Mark as Not a Plugin" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="20,14,20,20" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Close" Style="{StaticResource GhostButton}" Click="Close_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Save_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2713;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Save" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
