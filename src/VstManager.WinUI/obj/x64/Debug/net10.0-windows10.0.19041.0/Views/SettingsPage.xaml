<Page x:ConnectionId='1'
    x:Class="VstManager.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:VstManager.Core.Models"
    xmlns:ctrl="using:VstManager.WinUI.Controls">

    <ScrollViewer Padding="24,8,24,24">
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="4" CornerRadius="2"
                        Background="{StaticResource AccentGradientBrush}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Settings" FontSize="30" FontWeight="Bold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="This prototype reads an isolated copy of your library."
                               FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Appearance -->
            <Border CornerRadius="10" Padding="16" Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Theme" FontSize="14"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="Follows the app's theme. Mica tints the window with your desktop wallpaper."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:ConnectionId='11' Grid.Column="1" x:Name="ThemeCombo" MinWidth="130"
                              VerticalAlignment="Center"                                 >
                        <ComboBoxItem Content="System" Tag="Default" IsSelected="True" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Scan folders (read-only in the prototype) -->
            <Border CornerRadius="10" Padding="16" Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <StackPanel>
                        <TextBlock Text="Scan folders" FontSize="14"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="Where plugins are discovered."
                                   FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ItemsControl x:ConnectionId='7'                                   >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                      >
                                <Border x:ConnectionId='9' CornerRadius="8" Padding="10,7" Margin="0,0,0,5"
                                        Background="{ThemeResource SurfaceAltBrush}">
                                    <TextBlock x:ConnectionId='10'                 FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Tags -->
            <Border CornerRadius="10" Padding="16" Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel>
                        <TextBlock Text="Tags" FontSize="14"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="The built-in tag vocabulary, shared with the WPF app."
                                   FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ItemsControl x:ConnectionId='3'                            >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctrl:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                                >
                                <Border x:ConnectionId='5' CornerRadius="10" Padding="10,4"
                                                                                                             >
                                    <TextBlock x:ConnectionId='6'                      FontSize="11" FontWeight="SemiBold"
                                               Foreground="White" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Data location, so the isolation is visible rather than implied -->
            <Border CornerRadius="10" Padding="16" Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Data location" FontSize="14"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="This prototype writes here, never to the WPF app's folder."
                               FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock x:ConnectionId='2'                            FontSize="11" FontFamily="Consolas"
                               IsTextSelectionEnabled="True" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

