<Page
    x:Class="VstManager.WinUI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:VstManager.WinUI.ViewModels"
    xmlns:ctrl="using:VstManager.WinUI.Controls"
    xmlns:core="using:VstManager.Core.Models"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedPlugins" IsSourceGrouped="True" />

        <!-- One plugin card. WinUI states (PointerOver etc.) come from the GridViewItem template,
             so the hover glow is driven by VisualStateManager rather than WPF triggers. -->
        <DataTemplate x:Key="PluginCardTemplate" x:DataType="vm:PluginDisplayViewModel">
            <!-- Height fits the worst case: a two-line name plus three tag chips wrapping onto two
                 rows. Too short and the bottom-aligned block in row 3 overflows upward and draws
                 over the vendor line. -->
            <Grid Width="188" Height="258" Padding="14" CornerRadius="12"
                  Background="{ThemeResource CardBackgroundBrush}"
                  BorderBrush="{ThemeResource CardBorderBrush}"
                  BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Artwork -->
                <Border Grid.Row="0" Width="64" Height="64" CornerRadius="10"
                        HorizontalAlignment="Center" Margin="0,0,0,10"
                        Background="{ThemeResource SurfaceAltBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xEC4F;" FontSize="26"
                                  Foreground="{ThemeResource TextSecondaryBrush}" />
                        <Image Stretch="UniformToFill"
                               Opacity="{x:Bind IsInstalled, Converter={StaticResource BoolToOpacity}, Mode=OneWay}"
                               Source="{x:Bind LogoPath, Converter={StaticResource PathToImage}, Mode=OneWay}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                           TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextPrimaryBrush}" />

                <TextBlock Grid.Row="2" Text="{x:Bind VendorDisplay}" FontSize="12"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           Foreground="{ThemeResource TextSecondaryBrush}" />

                <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Spacing="6">
                    <TextBlock Text="{x:Bind InstalledSummaryText, Mode=OneWay}" FontSize="11"
                               TextAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}"
                               Visibility="{x:Bind InstalledSummaryText, Converter={StaticResource StringToVisibility}, Mode=OneWay}" />

                    <!-- Status + type chips -->
                    <ItemsControl ItemsSource="{x:Bind VisibleTags, Mode=OneWay}"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctrl:WrapPanel HorizontalSpacing="4" VerticalSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:TagDefinition">
                                <Border CornerRadius="9" Padding="7,2"
                                        Background="{x:Bind ColorHex, Converter={StaticResource HexToBrush}}">
                                    <TextBlock Text="{x:Bind Name}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="White" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <Border CornerRadius="9" Padding="8,2"
                                Background="{x:Bind Tag, Converter={StaticResource TagSummaryToBrush}, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Tag, Converter={StaticResource TagSummaryToText}, Mode=OneWay}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <Border CornerRadius="9" Padding="8,2"
                                Background="{ThemeResource OutdatedBrush}"
                                Visibility="{x:Bind IsOutdated, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                            <TextBlock Text="UPDATE" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Favourite, top-right -->
                <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Padding="4"
                        Click="Favorite_Click" Tag="{x:Bind}"
                        ToolTipService.ToolTip="Toggle favourite">
                    <FontIcon FontSize="14"
                              Glyph="{x:Bind IsFavorite, Converter={StaticResource FavoriteGlyph}, Mode=OneWay}"
                              Foreground="#FFFBBF24" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,8,24,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: gradient accent bar + title + live summary -->
        <Grid Grid.Row="0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="4" CornerRadius="2"
                    Background="{StaticResource AccentGradientBrush}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Library" FontSize="30" FontWeight="Bold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" FontSize="13"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Command bar: search, filter, sort -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox Grid.Column="0" MaxWidth="380" HorizontalAlignment="Left"
                            PlaceholderText="Search plugins, vendors, tags…"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <DropDownButton Grid.Column="1" Content="Filter">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem Text="All" GroupName="filter" IsChecked="True" Click="Filter_Click" Tag="All" />
                        <RadioMenuFlyoutItem Text="Installed" GroupName="filter" Click="Filter_Click" Tag="Installed" />
                        <RadioMenuFlyoutItem Text="Updates available" GroupName="filter" Click="Filter_Click" Tag="Outdated" />
                        <RadioMenuFlyoutItem Text="Favorites" GroupName="filter" Click="Filter_Click" Tag="Favorites" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <DropDownButton Grid.Column="2" Content="Sort">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem Text="Name" GroupName="sort" IsChecked="True" Click="Sort_Click" Tag="Name" />
                        <RadioMenuFlyoutItem Text="Vendor" GroupName="sort" Click="Sort_Click" Tag="Vendor" />
                        <RadioMenuFlyoutItem Text="Type" GroupName="sort" Click="Sort_Click" Tag="Type" />
                        <RadioMenuFlyoutItem Text="Update status" GroupName="sort" Click="Sort_Click" Tag="UpdateStatus" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <muxc:ProgressRing Grid.Row="2" IsActive="True" Width="40" Height="40"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

        <!-- Grouped card grid with sticky section headers -->
        <GridView x:Name="PluginGrid"
                  Grid.Row="2"
                  ItemsSource="{x:Bind GroupedPlugins.View, Mode=OneWay}"
                  ItemTemplate="{StaticResource PluginCardTemplate}"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="PluginGrid_ItemClick"
                  Padding="0,0,0,24"
                  Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse, Mode=OneWay}">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:PluginGroup">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,12">
                                <TextBlock Text="{x:Bind Name}" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                        Background="{ThemeResource SurfaceAltBrush}">
                                    <TextBlock Text="{x:Bind CountText}" FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
        </GridView>
    </Grid>
</Page>
