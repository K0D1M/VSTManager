<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VstManager.Ui.ViewModels"
        xmlns:conv="using:VstManager.Ui.Converters"
        xmlns:model="using:VstManager.Core.Models"
        x:Class="VstManager.Ui.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="VST Manager"
        Icon="avares://VstManager.Ui/Assets/app-icon.ico"
        Width="1180" Height="760"
        MinWidth="640" MinHeight="440"
        KeyDown="OnLibraryKeyDown"
        Background="{DynamicResource WindowBackgroundGradient}">

    <Window.Resources>
        <conv:CloudStateBrushConverter x:Key="CloudStateBrush" />
        <conv:CloudStateIsSyncingConverter x:Key="CloudStateIsSyncing" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToEyeIconConverter x:Key="BoolToEyeIcon" />

        <!-- One menu definition, attached to both templates below, so the grid and list can
             never offer different actions. Commands are reached through the window rather than
             the item's own DataContext, which is the card; ContextFlyout sits outside the
             ItemsControl's visual tree, so $parent[ItemsControl] does not resolve from here. -->
        <MenuFlyout x:Key="PluginMenu" x:DataType="vm:PluginCardViewModel">
            <MenuItem Header="Details…"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenDetailsCommand}"
                      CommandParameter="{Binding}" />

            <Separator />

            <MenuItem Header="Toggle Favourite"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{Binding HideMenuLabel}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleHiddenCommand}"
                      CommandParameter="{Binding}" />

            <Separator />

            <MenuItem Header="Mark Legit"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MarkLegitCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsInstalled}" />
            <MenuItem Header="Mark Cracked"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MarkCrackedCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsInstalled}" />
            <MenuItem Header="Clear Classification"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MarkUnclassifiedCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsInstalled}" />

            <Separator />

            <MenuItem Header="Mark as Instrument"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MarkInstrumentCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsInstalled}" />
            <MenuItem Header="Mark as Effect"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MarkEffectCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsInstalled}" />


            <Separator />

            <MenuItem Header="Re-detect Version"
                      ToolTip.Tip="Re-reads the installed version from the plugin file"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RefreshMetadataCommand}"
                      CommandParameter="{Binding}" IsEnabled="{Binding IsInstalled}" />

            <Separator IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).HasFolders}" />

            <!-- A Click handler opening its own small picker window, not a nested submenu: this
                 flyout's MenuItem submenus did not reliably open on hover when tried here (see
                 FolderPickerWindow's doc comment for how that was confirmed). Click, not Command,
                 since the handler needs the card straight off this item's own DataContext. -->
            <MenuItem Header="Move to Folder…"
                      IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).HasFolders}"
                      Click="MoveToFolder_Click" />

            <Separator />

            <!-- Click, not Command: the confirmation wording depends on whether a registered
                 uninstaller was found, which the window has to look up before it knows what to
                 ask — see Uninstall_Click. -->
            <MenuItem Header="Uninstall…" Foreground="{DynamicResource CrackedBrush}"
                      IsEnabled="{Binding IsInstalled}"
                      Click="Uninstall_Click" />
        </MenuFlyout>

        <!-- Card body, shared by the grid and list templates so the two layouts can never
             drift apart in what they show. -->
        <DataTemplate x:Key="CardTemplate" x:DataType="vm:PluginCardViewModel">
            <Border Classes="card" Classes.selected="{Binding IsSelected}" Width="252"
                    DoubleTapped="OnPluginDoubleTapped"
                    Focusable="True"
                    ContextFlyout="{StaticResource PluginMenu}"
                    PointerPressed="OnPluginPointerPressed">
                <StackPanel Spacing="10">

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0"
                                CornerRadius="{DynamicResource RadiusMedium}"
                                Background="{DynamicResource SurfaceAltBrush}"
                                ClipToBounds="True">
                            <Panel>
                                <TextBlock Text="{Binding Initial}"
                                           IsVisible="{Binding Logo, Converter={x:Static ObjectConverters.IsNull}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Image Source="{Binding Logo}" Stretch="UniformToFill" />
                            </Panel>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Classes="title" Text="{Binding Name}"
                                       ToolTip.Tip="{Binding Name}" />
                            <TextBlock Classes="subtitle" Text="{Binding Vendor}" />
                        </StackPanel>

                        <ToggleButton Grid.Column="2" Classes="star"
                                      IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                                      CommandParameter="{Binding}"
                                      ToolTip.Tip="Favourite" />
                    </Grid>

                    <TextBlock Classes="meta" Text="{Binding SummaryLine}" />

                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                        <Border Classes="chip status"
                                Classes.legit="{Binding IsLegit}"
                                Classes.cracked="{Binding IsCracked}"
                                Classes.muted="{Binding IsUnclassified}">
                            <TextBlock Text="{Binding TagLabel}" />
                        </Border>

                        <Border Classes="chip status new" IsVisible="{Binding IsNew}">
                            <TextBlock Text="NEW" />
                        </Border>

                        <Border Classes="chip status outdated" IsVisible="{Binding ShowOutdatedBadge}"
                                ToolTip.Tip="{Binding UpdateTooltip}">
                            <TextBlock Text="OUTDATED" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate" x:DataType="vm:PluginCardViewModel">
            <Border Classes="row" Classes.selected="{Binding IsSelected}"
                    DoubleTapped="OnPluginDoubleTapped"
                    Focusable="True"
                    ContextFlyout="{StaticResource PluginMenu}"
                    PointerPressed="OnPluginPointerPressed">
                <!-- Star-sized name/vendor with a capped vendor column: at wide window sizes a
                     pure 2*/1.4* split pushed the vendor into the middle of empty space. -->
                <Grid ColumnDefinitions="Auto,*,220,150,Auto" VerticalAlignment="Center">

                    <Border Grid.Column="0" Width="26" Height="26" Margin="0,0,12,0"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True">
                        <Panel>
                            <TextBlock Text="{Binding Initial}"
                                       IsVisible="{Binding Logo, Converter={x:Static ObjectConverters.IsNull}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Image Source="{Binding Logo}" Stretch="UniformToFill" />
                        </Panel>
                    </Border>

                    <TextBlock Grid.Column="1" Classes="title" Text="{Binding Name}"
                               ToolTip.Tip="{Binding Name}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Classes="subtitle" Text="{Binding Vendor}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="3" Classes="meta" Text="{Binding SummaryLine}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <Border Classes="chip status"
                                Classes.legit="{Binding IsLegit}"
                                Classes.cracked="{Binding IsCracked}"
                                Classes.muted="{Binding IsUnclassified}">
                            <TextBlock Text="{Binding TagLabel}" />
                        </Border>
                        <Border Classes="chip status outdated" IsVisible="{Binding ShowOutdatedBadge}"
                                ToolTip.Tip="{Binding UpdateTooltip}">
                            <TextBlock Text="OUTDATED" />
                        </Border>
                        <ToggleButton Classes="star"
                                      IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                                      CommandParameter="{Binding}"
                                      ToolTip.Tip="Favourite" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Pulses the cloud icon while actively syncing, matching the WPF toolbar's
             DataTrigger + Storyboard. Alternate playback is Avalonia's auto-reverse. -->
        <Style Selector="Path.cloudIcon.syncing">
            <Style.Animations>
                <Animation Duration="0:0:0.7" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <!-- The zoom wrapper. LayoutTransformControl, not RenderTransform: it re-runs layout at the
         scaled size, so the card grid still reflows, scrolling still works and nothing is just a
         stretched bitmap. The toast host and zoom readout sit outside it so they keep a constant
         size regardless of zoom. -->
    <Panel>
        <LayoutTransformControl x:Name="ZoomHost">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Header ......................................................... -->
        <Grid Grid.Row="0" Margin="20,18,20,10" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="VST Manager" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Classes="subtitle" Text="{Binding StatusLine}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button Classes="ghost" Command="{Binding ToggleThemeCommand}"
                        ToolTip.Tip="Switch between light and dark">
                    <TextBlock Text="◐" FontSize="15" />
                </Button>
                <!-- Cloud indicator. Only shown once sync is on, so a user who never enables it
                     never sees a permanently grey icon asking to be explained. A cloud silhouette
                     rather than a plain dot, matching the WPF toolbar; the "syncing" class drives
                     the pulse animation declared above. -->
                <Button Classes="ghost" Command="{Binding SyncCloudNowCommand}"
                        IsVisible="{Binding CloudSyncEnabled}"
                        ToolTip.Tip="{Binding CloudStatusMessage}">
                    <Path Classes="cloudIcon" Width="20" Height="14" Stretch="Uniform"
                          VerticalAlignment="Center"
                          Classes.syncing="{Binding CloudState, Converter={StaticResource CloudStateIsSyncing}}"
                          Fill="{Binding CloudState, Converter={StaticResource CloudStateBrush}}"
                          Data="{StaticResource CloudGlyph}" />
                </Button>

                <Button Classes="ghost" Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Settings">
                    <TextBlock Text="⚙" FontSize="15" />
                </Button>
                <Button Classes="accent" Command="{Binding RescanCommand}"
                        IsEnabled="{Binding !IsScanning}" Content="Rescan" />

                <!-- Always exits, even with "Minimize to tray" on — Close() alone would just hide
                     the window in that case (see OnMainWindowClosing). -->
                <Button Classes="ghost" Click="Quit_Click"
                        ToolTip.Tip="Quit VST Manager">
                    <TextBlock Text="⏻" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Toolbar. Wraps rather than clips, so a narrow window stacks its groups. -->
        <WrapPanel Grid.Row="1" Margin="20,0,20,10" ItemSpacing="10" LineSpacing="10">

            <TextBox Classes="search" Width="280"
                     PlaceholderText="Search plugins or vendors…"
                     Text="{Binding SearchText}" />

            <Border Classes="segmentGroup">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton Classes="segment all" GroupName="mode" Content="All"
                                 IsChecked="{Binding IsModeAll}" />
                    <RadioButton x:Name="LegitSegment" Classes="segment legit" GroupName="mode"
                                 IsChecked="{Binding IsModeLegit}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="segmentIcon" Data="{StaticResource IconCheck}"
                                  Stroke="{Binding #LegitSegment.Foreground}" />
                            <TextBlock Text="Legit" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CrackedSegment" Classes="segment cracked" GroupName="mode"
                                 IsChecked="{Binding IsModeCracked}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="segmentIcon" Data="{StaticResource IconSkull}"
                                  Stroke="{Binding #CrackedSegment.Foreground}" />
                            <TextBlock Text="Cracked" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border Classes="segmentGroup">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <!-- Two-way IsChecked rather than a Command: RadioButton does not invoke
                         Command on a programmatic Select(), and a OneWay binding fights the
                         click. Binding the state directly makes both paths agree. -->
                    <RadioButton Classes="segment plain" GroupName="layout" Content="▦"
                                 IsChecked="{Binding IsGrid}"
                                 ToolTip.Tip="Grid view" />
                    <RadioButton Classes="segment plain" GroupName="layout" Content="☰"
                                 IsChecked="{Binding IsList}"
                                 ToolTip.Tip="List view" />
                </StackPanel>
            </Border>

            <!-- SelectedValue is bound straight to the Sort enum property (SelectedValueBinding
                 picks it off each item's Tag, set here to the enum member itself rather than its
                 string name), so this is a genuine two-way binding rather than an event handler —
                 the same reason WPF's own sort control (RadioButtons bound to SortOption via
                 EnumEqualsConverter) never needed separate code to restore the persisted choice on
                 launch: a live two-way binding re-reads the current value from the view model as
                 soon as it exists, with nothing extra to wire up in either direction. -->
            <!-- Filter popup: Status/Format/Tags narrowing, matching WPF's dedicated Filter
                 button — previously absent from this project entirely (only the Favourites/
                 Updates/Hidden toggles below existed). IconFunnel is a filled silhouette (WPF's
                 Styles.xaml:29), not a stroke icon, so Fill tracks the toggle's own Foreground
                 the same way the Legit/Cracked segment icons do. -->
            <ToggleButton x:Name="FilterToggle" Classes="ghost" Padding="10,5"
                          ToolTip.Tip="Narrow the list by status, format, tags and more">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconFunnel}" Stretch="Uniform" Width="13" Height="13"
                          Fill="{Binding #FilterToggle.Foreground}" />
                    <TextBlock Text="Filter" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <Popup PlacementTarget="{Binding #FilterToggle}"
                   Placement="Bottom" IsOpen="{Binding #FilterToggle.IsChecked, Mode=TwoWay}"
                   IsLightDismissEnabled="True">
                <Border Classes="section" Width="260" Margin="0,6,0,0" Padding="12">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Filters" Classes="label" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="ghost" Content="Reset" Padding="8,3" FontSize="12"
                                    Command="{Binding ResetFiltersCommand}" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Status" Classes="meta" />
                            <Border Classes="segmentGroup">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Classes="segment" GroupName="filterStatus" Content="All"
                                                 IsChecked="{Binding IsStatusAll}" />
                                    <RadioButton Classes="segment" GroupName="filterStatus" Content="Installed"
                                                 IsChecked="{Binding IsStatusInstalled}" />
                                    <RadioButton Classes="segment" GroupName="filterStatus" Content="Not Installed"
                                                 IsChecked="{Binding IsStatusNotInstalled}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Format" Classes="meta" />
                            <Border Classes="segmentGroup">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Classes="segment" GroupName="filterFormat" Content="All"
                                                 IsChecked="{Binding IsFormatAll}" />
                                    <RadioButton Classes="segment" GroupName="filterFormat" Content="VST2"
                                                 IsChecked="{Binding IsFormatVst2}" />
                                    <RadioButton Classes="segment" GroupName="filterFormat" Content="VST3"
                                                 IsChecked="{Binding IsFormatVst3}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ToggleSwitch, not CheckBox, matching the earlier Settings-window
                             session so this new popup doesn't reintroduce a checkbox. -->
                        <ToggleSwitch IsChecked="{Binding ShowHidden}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="tabIcon" Width="13" Height="13"
                                      Data="{Binding ShowHidden, Converter={StaticResource BoolToEyeIcon}}"
                                      Stroke="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Show hidden plugins" />
                            </StackPanel>
                        </ToggleSwitch>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Tags" Classes="meta" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="ghost" Content="Clear" Padding="6,1" FontSize="11"
                                    Command="{Binding ClearTagFilterCommand}"
                                    IsVisible="{Binding HasTagFilter}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AvailableTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="model:TagDefinition">
                                    <Button Classes="ghost"
                                            Padding="8,4" FontSize="11"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleTagFilterCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <ComboBox MinWidth="150" VerticalAlignment="Center"
                      ToolTip.Tip="Sort order"
                      SelectedValueBinding="{CompiledBinding Tag, x:DataType=ComboBoxItem}"
                      SelectedValue="{Binding Sort}">
                <ComboBoxItem Content="Sort: Name" Tag="{x:Static vm:SortOption.Name}" />
                <ComboBoxItem Content="Sort: Vendor" Tag="{x:Static vm:SortOption.Vendor}" />
                <ComboBoxItem Content="Sort: Type" Tag="{x:Static vm:SortOption.Type}" />
                <ComboBoxItem Content="Sort: Updates" Tag="{x:Static vm:SortOption.UpdateStatus}" />
            </ComboBox>

            <Button Classes="ghost" Command="{Binding ReverseSortDirectionCommand}"
                    ToolTip.Tip="Reverse sort direction">
                <TextBlock Text="⇅" FontSize="14" />
            </Button>

            <ToggleButton Classes="filterToggle" Content="★ Favourites"
                          IsChecked="{Binding FavoritesOnly}" />
            <ToggleButton Classes="filterToggle" Content="↻ Updates"
                          IsChecked="{Binding OutdatedOnly}" />
            <!-- IconEyeOff (crossed) when hidden plugins are NOT shown, IconEye (open) when they
                 are — the icon reflects the toggle's actual current state, not just a static
                 label, since ShowHidden's own name reads ambiguously at a glance otherwise. -->
            <ToggleButton x:Name="HiddenToggle" Classes="filterToggle"
                          IsChecked="{Binding ShowHidden}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="tabIcon" Width="13" Height="13"
                          Data="{Binding ShowHidden, Converter={StaticResource BoolToEyeIcon}}"
                          Stroke="{Binding #HiddenToggle.Foreground}" />
                    <TextBlock Text="Hidden" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <!-- Bulk tag: mark every currently-visible installed plugin, distinct from the
                 per-card "Mark Legit/Cracked" in the context menu and selection bar. -->
            <ToggleButton x:Name="MarkAllToggle" Classes="ghost" Padding="10,5"
                          ToolTip.Tip="Mark all visible installed plugins by tag">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🏷" FontSize="13" />
                    <TextBlock Text="Mark All" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <Popup PlacementTarget="{Binding #MarkAllToggle}"
                   Placement="Bottom" IsOpen="{Binding #MarkAllToggle.IsChecked, Mode=TwoWay}"
                   IsLightDismissEnabled="True">
                <Border Classes="section" Width="200" Margin="0,6,0,0" Padding="6">
                    <StackPanel>
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding MarkAllLegitCommand}"
                                ToolTip.Tip="Mark all visible installed plugins as Legit">
                            <TextBlock Text="✓ Mark All Legit" />
                        </Button>
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Margin="0,4,0,0"
                                Command="{Binding MarkAllCrackedCommand}"
                                ToolTip.Tip="Mark all visible installed plugins as Cracked">
                            <TextBlock Text="☠ Mark All Cracked" />
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <Button Classes="ghost" Padding="10,5"
                    Click="RefreshAllMetadata_Click"
                    ToolTip.Tip="Re-checks installed versions and looks up the latest release for every installed plugin">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="↻" FontSize="13" />
                    <TextBlock Text="Refresh All Metadata" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- Folders. A place, not a filter chip: the user's own structure, so it gets its own
             collapsible section rather than one more toggle in the row above. This layout has no
             sidebar to nest a tree inside like WPF's, so a folder narrows the main grid via
             SelectedFolderId instead of hosting its own inline grid — clicking a row is "show me
             just this" and behaves like the other single-choice filters (Legit/Cracked/etc). -->
        <Border Grid.Row="2" Classes="section" Margin="20,0,20,10" Padding="12,10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <ToggleButton Grid.Column="0" Classes="ghost" Padding="4"
                                  IsChecked="{Binding IsFoldersExpanded}"
                                  IsVisible="{Binding HasFolders}">
                        <Panel>
                            <TextBlock Text="▾" IsVisible="{Binding $parent[ToggleButton].IsChecked}" />
                            <TextBlock Text="▸" IsVisible="{Binding !$parent[ToggleButton].IsChecked}" />
                        </Panel>
                    </ToggleButton>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="📂" FontSize="14" />
                        <TextBlock Text="Folders" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Classes="chip" IsVisible="{Binding SelectedFolder, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding SelectedFolder.Name}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="2" Classes="ghost" Padding="8,4" FontSize="12" Margin="0,0,6,0"
                            Content="✕ Show All"
                            IsVisible="{Binding SelectedFolder, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Command="{Binding ClearFolderFilterCommand}" />

                    <Button Grid.Column="3" Classes="ghost" Padding="8,4" FontSize="12"
                            ToolTip.Tip="Create a new top-level folder"
                            Command="{Binding CreateFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="+" FontSize="13" />
                            <TextBlock Text="New Folder" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding VisibleFolders}" IsVisible="{Binding IsFoldersExpanded}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderNodeViewModel">
                            <Border CornerRadius="8" Padding="8,6" Margin="{Binding Indent}"
                                    Background="Transparent"
                                    PointerPressed="OnFolderRowPressed">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem Header="New Sub-folder"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CreateFolderCommand}"
                                                  CommandParameter="{Binding Id}" />
                                        <MenuItem Header="Edit…" Click="EditFolder_Click" />
                                        <Separator />
                                        <MenuItem Header="Move to Top Level"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveFolderToRootCommand}"
                                                  CommandParameter="{Binding Id}" />
                                        <Separator />
                                        <MenuItem Header="Delete Folder" Click="DeleteFolder_Click" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>

                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Classes="meta" VerticalAlignment="Center"
                                               Text="{Binding TotalCount, StringFormat='{}{0}'}" />

                                    <Border DockPanel.Dock="Left" Width="4" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                            Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />

                                    <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayIcon}" FontSize="14" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />

                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="meta" IsVisible="{Binding !HasFolders}" TextWrapping="Wrap"
                           Text="No folders yet — use New Folder above, or right-click a plugin to file it once you have one." />
            </StackPanel>
        </Border>

        <!-- Selection bar, only while something is selected. ................ -->
        <Border Grid.Row="3" Margin="20,0,20,10" Padding="12,8"
                IsVisible="{Binding HasSelection}"
                Background="{DynamicResource SurfaceAltBrush}"
                CornerRadius="{DynamicResource RadiusMedium}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" />

                <!-- These pass the *anchor* card; ApplyToTargets then expands to the whole
                     selection, so one command serves both the menu and this bar. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost" Content="Legit"
                            Command="{Binding MarkLegitCommand}"
                            CommandParameter="{Binding SelectionAnchor}" />
                    <Button Classes="ghost" Content="Cracked"
                            Command="{Binding MarkCrackedCommand}"
                            CommandParameter="{Binding SelectionAnchor}" />
                    <Button Classes="ghost" Content="Hide"
                            Command="{Binding ToggleHiddenCommand}"
                            CommandParameter="{Binding SelectionAnchor}" />
                    <Button Classes="ghost" Content="Clear"
                            Command="{Binding ClearSelectionCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Library ........................................................ -->
        <Panel Grid.Row="4">

            <!-- Grouped by Kind — Instruments / Effects / Unclassified — matching the WPF
                 sidebar's collapsible sections, each independently expandable with its own
                 count. One scroller for the whole page (as in WPF), not one per section: a
                 section has no fixed height of its own to scroll within. -->
            <ScrollViewer x:Name="GridScroll" Padding="20,0,20,20" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsGrid}">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="10" IsVisible="{Binding InstrumentsCount}">
                        <ToggleButton Classes="ghost sectionHeaderToggle"
                                      IsChecked="{Binding IsInstrumentsSectionExpanded}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🎹" FontSize="14" />
                                <TextBlock Text="Instruments" Classes="sectionHeader" />
                                <TextBlock Classes="meta" Text="{Binding InstrumentsCount, StringFormat='({0})'}" />
                            </StackPanel>
                        </ToggleButton>
                        <ItemsControl x:Name="InstrumentGridItems" ItemsSource="{Binding InstrumentPlugins}"
                                      ItemTemplate="{StaticResource CardTemplate}"
                                      IsVisible="{Binding IsInstrumentsSectionExpanded}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="14" LineSpacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding EffectsCount}">
                        <ToggleButton Classes="ghost sectionHeaderToggle"
                                      IsChecked="{Binding IsEffectsSectionExpanded}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🎛" FontSize="14" />
                                <TextBlock Text="Effects" Classes="sectionHeader" />
                                <TextBlock Classes="meta" Text="{Binding EffectsCount, StringFormat='({0})'}" />
                            </StackPanel>
                        </ToggleButton>
                        <ItemsControl x:Name="EffectGridItems" ItemsSource="{Binding EffectPlugins}"
                                      ItemTemplate="{StaticResource CardTemplate}"
                                      IsVisible="{Binding IsEffectsSectionExpanded}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="14" LineSpacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding UnclassifiedKindCount}">
                        <ToggleButton Classes="ghost sectionHeaderToggle"
                                      IsChecked="{Binding IsUnclassifiedKindSectionExpanded}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="❔" FontSize="14" />
                                <TextBlock Text="Unclassified Type" Classes="sectionHeader" />
                                <TextBlock Classes="meta" Text="{Binding UnclassifiedKindCount, StringFormat='({0})'}" />
                            </StackPanel>
                        </ToggleButton>
                        <ItemsControl x:Name="UnclassifiedGridItems" ItemsSource="{Binding UnclassifiedKindPlugins}"
                                      ItemTemplate="{StaticResource CardTemplate}"
                                      IsVisible="{Binding IsUnclassifiedKindSectionExpanded}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="14" LineSpacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ListScroll" Padding="20,0,20,20" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsList}">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="10" IsVisible="{Binding InstrumentsCount}">
                        <ToggleButton Classes="ghost sectionHeaderToggle"
                                      IsChecked="{Binding IsInstrumentsSectionExpanded}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🎹" FontSize="14" />
                                <TextBlock Text="Instruments" Classes="sectionHeader" />
                                <TextBlock Classes="meta" Text="{Binding InstrumentsCount, StringFormat='({0})'}" />
                            </StackPanel>
                        </ToggleButton>
                        <ItemsControl x:Name="InstrumentListItems" ItemsSource="{Binding InstrumentPlugins}"
                                      ItemTemplate="{StaticResource RowTemplate}"
                                      IsVisible="{Binding IsInstrumentsSectionExpanded}" />
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding EffectsCount}">
                        <ToggleButton Classes="ghost sectionHeaderToggle"
                                      IsChecked="{Binding IsEffectsSectionExpanded}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🎛" FontSize="14" />
                                <TextBlock Text="Effects" Classes="sectionHeader" />
                                <TextBlock Classes="meta" Text="{Binding EffectsCount, StringFormat='({0})'}" />
                            </StackPanel>
                        </ToggleButton>
                        <ItemsControl x:Name="EffectListItems" ItemsSource="{Binding EffectPlugins}"
                                      ItemTemplate="{StaticResource RowTemplate}"
                                      IsVisible="{Binding IsEffectsSectionExpanded}" />
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding UnclassifiedKindCount}">
                        <ToggleButton Classes="ghost sectionHeaderToggle"
                                      IsChecked="{Binding IsUnclassifiedKindSectionExpanded}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="❔" FontSize="14" />
                                <TextBlock Text="Unclassified Type" Classes="sectionHeader" />
                                <TextBlock Classes="meta" Text="{Binding UnclassifiedKindCount, StringFormat='({0})'}" />
                            </StackPanel>
                        </ToggleButton>
                        <ItemsControl x:Name="UnclassifiedListItems" ItemsSource="{Binding UnclassifiedKindPlugins}"
                                      ItemTemplate="{StaticResource RowTemplate}"
                                      IsVisible="{Binding IsUnclassifiedKindSectionExpanded}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Designed loading and empty states rather than a blank panel. -->
            <StackPanel IsVisible="{Binding IsScanning}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="Scanning your plugin folders…" Classes="sectionHeader"
                           HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="220" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsEmpty}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Nothing matches those filters" Classes="sectionHeader"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="subtitle" HorizontalAlignment="Center"
                           Text="Try a different search, or clear the filters." />
                <Button Classes="accent" Content="Clear filters" HorizontalAlignment="Center"
                        Command="{Binding ClearFiltersCommand}" />
            </StackPanel>

        </Panel>

    </Grid>
        </LayoutTransformControl>

        <!-- Flashed on each zoom change and faded out: the keyboard and wheel shortcuts have no
             other feedback, and the clamped ends are only obvious once the number stops moving. -->
        <Border x:Name="ZoomIndicator"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusLarge}"
                Padding="28,18"
                IsHitTestVisible="False"
                Opacity="0" IsVisible="False">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Border.Transitions>
            <TextBlock x:Name="ZoomIndicatorText" Text="100%"
                       FontSize="34" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>

    </Panel>
</Window>
