<Window x:Class="VstManager.App.Views.PluginDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:core="clr-namespace:VstManager.Core.Models;assembly=VstManager.Core"
        mc:Ignorable="d"
        Title="{Binding Name}" Width="700" Height="600"
        MinWidth="580" MinHeight="460"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Icon>
        <MultiBinding Converter="{StaticResource LogoConverter}">
            <Binding Path="LogoPath" />
            <Binding Path="IsInstalled" />
        </MultiBinding>
    </Window.Icon>

    <Grid Margin="20,18,20,16" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" From="0.98" To="1" Duration="0:0:0.28">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" From="0.98" To="1" Duration="0:0:0.28">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: identity at a glance -->
        <Border Grid.Row="0" Style="{StaticResource SettingsCard}" Margin="0,0,0,16" Padding="14,12">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Width="60" Height="60" CornerRadius="10" Margin="0,0,14,0"
                        Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="&#x1F3B9;" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding LogoPath, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" />
                        <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource LogoConverter}">
                                    <Binding Path="LogoPath" />
                                    <Binding Path="IsInstalled" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                    </Grid>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Vendor}" FontSize="13" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding Vendor, Converter={StaticResource StringToVisibilityConverter}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Style="{StaticResource TagBadge}" Margin="0,0,6,0" Padding="8,2"
                                Background="{Binding Tag, Converter={StaticResource TagBrushConverter}}">
                            <TextBlock Text="{Binding Tag, Converter={StaticResource TagTextConverter}}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <Border Style="{StaticResource TagBadge}" Margin="0,0,6,0" Padding="8,2"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                Visibility="{Binding InstalledFormatsText, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding InstalledFormatsText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                        <Border Style="{StaticResource TagBadge}" Padding="8,2"
                                Background="{DynamicResource OutdatedBrush}"
                                ToolTip="{Binding LatestVersion, StringFormat='A newer version (v{0}) is available'}"
                                Visibility="{Binding IsOutdated, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="OUTDATED" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sections -->
        <TabControl Grid.Row="1" Style="{StaticResource SettingsTabControl}">

            <!-- Details -->
            <TabItem Header="Details" Style="{StaticResource SettingsNavItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Identity" Style="{StaticResource SettingsSectionTitle}" />
                        <TextBlock Style="{StaticResource SettingsSectionCaption}"
                                   Text="How this plugin is shown in your library." />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Name" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource SearchBox}"
                                                 Text="{Binding Form.Name, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Vendor" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                        <TextBox Style="{StaticResource SearchBox}"
                                                 Text="{Binding Form.Vendor, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Button Style="{StaticResource GhostButton}" Padding="12,7" FontSize="13"
                                        HorizontalAlignment="Left" Click="AutoDetect_Click"
                                        IsEnabled="{Binding Form.IsAutoDetecting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolConverter}}"
                                        ToolTip="Look this plugin up automatically and fill in what's found">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2728;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Auto-Detect" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,8,0,0"
                                           Text="{Binding Form.AutoDetectStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="{Binding Form.AutoDetectStatusText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Classification" Style="{StaticResource SettingsSectionTitle}" Margin="0,4,0,4" />
                        <TextBlock Style="{StaticResource SettingsSectionCaption}"
                                   Text="Used by the Instruments / Effects tabs and the Legit / Cracked filter." />

                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Type" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                    <Border CornerRadius="17" Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="Kind" Content="Instrument" Tag="&#x1F3B9;" Style="{StaticResource ModeSegment}"
                                                         IsEnabled="{Binding IsInstalled}"
                                                         IsChecked="{Binding Form.Kind, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static core:PluginKind.Instrument}}"
                                                         Checked="InstrumentRadio_Checked" />
                                            <RadioButton GroupName="Kind" Content="Effect" Tag="&#x1F39B;" Style="{StaticResource ModeSegment}"
                                                         IsEnabled="{Binding IsInstalled}"
                                                         IsChecked="{Binding Form.Kind, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static core:PluginKind.Effect}}"
                                                         Checked="EffectRadio_Checked" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Status" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                    <Border CornerRadius="17" Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="Status" Content="Legit" Tag="&#x2714;" Style="{StaticResource ModeSegment}"
                                                         IsEnabled="{Binding IsInstalled}"
                                                         IsChecked="{Binding Form.SelectedTag, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static core:PluginTag.Legit}}"
                                                         Checked="LegitRadio_Checked" />
                                            <RadioButton GroupName="Status" Content="Cracked" Tag="&#x2620;" Style="{StaticResource ModeSegment}"
                                                         IsEnabled="{Binding IsInstalled}"
                                                         IsChecked="{Binding Form.SelectedTag, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static core:PluginTag.Cracked}}"
                                                         Checked="CrackedRadio_Checked" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Version" Style="{StaticResource SettingsSectionTitle}" Margin="0,4,0,4" />
                        <TextBlock Style="{StaticResource SettingsSectionCaption}"
                                   Text="An OUTDATED badge appears when the latest release is newer than what you have installed." />

                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Installed" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource SearchBox}"
                                             Text="{Binding Form.CurrentVersion, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsInstalled}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Latest available" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                    <!-- Detected online only; not hand-editable. -->
                                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="8"
                                            Padding="10,8" Background="{DynamicResource SurfaceAltBrush}">
                                        <TextBlock FontSize="14" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Form.LatestVersion, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Form.LatestVersion, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="Unknown" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Form.LatestVersion, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                                                            <Setter Property="Text" Value="Unknown" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Web lookup -->
            <TabItem Header="Web Info" Style="{StaticResource SettingsNavItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Get Details From a Web Page" Style="{StaticResource SettingsSectionTitle}" />
                        <TextBlock Style="{StaticResource SettingsSectionCaption}"
                                   Text="Paste this plugin's page on KVR Audio, another plugin database, or the vendor's own site. The name, vendor, version and artwork are read straight off that page." />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Page address" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                                            Padding="14,7" Margin="8,0,0,0" Click="FetchInfo_Click"
                                            IsEnabled="{Binding Form.IsFetchingInfo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2913;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Get Info" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox x:Name="InfoUrlTextBox" Style="{StaticResource SearchBox}"
                                             Text="{Binding Form.InfoUrl, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>

                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,10,0,0"
                                           Text="{Binding Form.LogoStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="{Binding Form.LogoStatusText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}"
                                Visibility="{Binding Form.IsLogoPreviewValid, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Artwork found" Style="{StaticResource SettingsLabel}" Margin="0,0,0,8" />
                                <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" Padding="8"
                                        MinHeight="90" MaxHeight="180">
                                    <Image x:Name="LogoPreviewImage" Stretch="Uniform" MaxHeight="164"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <TextBlock Style="{StaticResource SettingsHint}"
                                           Text="This image is saved as the plugin's artwork when you click Save." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Files -->
            <TabItem Header="Files" Style="{StaticResource SettingsNavItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Install Locations" Style="{StaticResource SettingsSectionTitle}" />
                        <TextBlock Style="{StaticResource SettingsSectionCaption}"
                                   Text="Every copy of this plugin found on disk. .vst3 files are VST3 format; .dll files are VST2." />

                        <Border Style="{StaticResource SettingsCard}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="This plugin isn't installed on this machine."
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource CrackedBrush}" />
                        </Border>

                        <!-- ActiveInstalls, not Installs: a plugin with one live copy and one
                             uninstalled copy must not list the removed file as present. -->
                        <ItemsControl ItemsSource="{Binding ActiveInstalls}"
                                      Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                            BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="0"
                                                    Width="30" Height="30" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="Show in Folder"
                                                    Tag="{Binding Path}" Click="ShowInFolder_Click">
                                                <Path Data="M1,3 L6,3 L7.5,4.5 L15,4.5 L15,13 L1,13 Z"
                                                      Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="14" Height="12" />
                                            </Button>
                                            <Border DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"
                                                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                                    BorderThickness="1" CornerRadius="5" Padding="7,3">
                                                <TextBlock Text="{Binding Format, Converter={StaticResource FormatToLabelConverter}}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Path}" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Remove From Library" Style="{StaticResource SettingsSectionTitle}" Margin="0,8,0,4" />
                        <TextBlock Style="{StaticResource SettingsSectionCaption}"
                                   Text="If this file isn't really a plugin, exclude it so future scans skip it." />

                        <Border Style="{StaticResource SettingsCard}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="12,7"
                                    Click="MarkAsNotAPlugin_Click"
                                    ToolTip="Excludes this file by name from future scans, on this and any other machine">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x26A0;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource CrackedBrush}" />
                                    <TextBlock Text="Mark as Not a Plugin" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource GhostButton}"
                    Padding="20,7" Click="Close_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="22,8" Click="Save_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2713;" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="Save Changes" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
