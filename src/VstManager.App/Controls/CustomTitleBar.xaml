<UserControl x:Class="VstManager.App.Controls.CustomTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             mc:Ignorable="d"
             Height="40"
             Background="{DynamicResource SurfaceBrush}"
             MouseLeftButtonDown="TitleArea_MouseLeftButtonDown"
             d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="CaptionButtonBase" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF1707A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Image x:Name="IconImage" Grid.Column="0" Width="16" Height="16" Margin="12,0,0,0"
               VerticalAlignment="Center"
               Source="{Binding TitleIcon, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <TextBlock x:Name="TitleTextBlock" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                   Text="{Binding TitleText, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <StackPanel Grid.Column="3" Orientation="Horizontal">
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonBase}"
                    Content="&#x2013;"
                    Click="MinimizeButton_Click" />
            <Button x:Name="MaximizeButton"
                    Click="MaximizeButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonBase}">
                        <Setter Property="Content" Value="&#x25A1;" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter Property="Content" Value="&#x25A3;" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}"
                    Content="&#x2715;"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
