<Window x:Class="VstManager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ctrl="clr-namespace:VstManager.App.Controls"
        mc:Ignorable="d"
        Title="Settings" Height="620" Width="740"
        MinHeight="460" MinWidth="660"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource ChromedWindowResizableWithGrip}"
        Loaded="Window_Loaded"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctrl:CustomTitleBar Grid.Row="0" ShowMaximize="False"
                             TitleText="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                             TitleIcon="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Icon}" />

    <Grid Grid.Row="1" Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <TabControl Grid.Row="1" Style="{StaticResource SettingsTabControl}">

            <!-- ============ General ============ -->
            <TabItem Style="{StaticResource SettingsNavItem}">
                <TabItem.Header>
                    <ctrl:SettingsTabHeader Icon="IconGeneral" Text="General" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SettingsSectionTitle}" />
                        <TextBlock Style="{StaticResource SettingsSectionCaption}"
                                   Text="Appearance and everyday behaviour." />

                        <Border Style="{StaticResource SettingsCard}">
                            <DockPanel LastChildFill="True">
                                <ToggleButton DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding IsDarkTheme}" Style="{StaticResource GhostToggleButton}"
                                              Padding="14,7" MinWidth="76"
                                              Content="{Binding IsDarkTheme, Converter={StaticResource ThemeLabelConverter}}" />
                                <StackPanel>
                                    <TextBlock Text="Theme" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Style="{StaticResource SettingsHint}"
                                               Text="Switch between the dark and light colour scheme." />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Accent colour" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,3,0,10"
                                           Text="Used for highlights, selected items and buttons." />

                                <ItemsControl ItemsSource="{Binding AccentSwatches}" Margin="0,0,0,12">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="30" Height="30" Margin="0,0,8,8" Padding="0" Cursor="Hand"
                                                    Background="{Binding Converter={StaticResource ColorToBrushConverter}}"
                                                    Command="{Binding DataContext.SelectAccentColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid RenderTransformOrigin="0.5,0.5">
                                                            <Grid.RenderTransform>
                                                                <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
                                                            </Grid.RenderTransform>
                                                            <Ellipse Fill="{TemplateBinding Background}"
                                                                     Stroke="{DynamicResource BorderBrush2}" StrokeThickness="1" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.11" />
                                                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.11" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="Custom hex" VerticalAlignment="Center"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />
                                    <Border Width="30" Height="30" DockPanel.Dock="Right" Margin="10,0,0,0" CornerRadius="8"
                                            Background="{Binding AccentColor, Converter={StaticResource ColorToBrushConverter}}"
                                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" />
                                    <TextBox Style="{StaticResource SearchBox}"
                                             Text="{Binding AccentHexInput, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <DockPanel LastChildFill="True">
                                <ToggleButton DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding AutostartEnabled}" Style="{StaticResource GhostToggleButton}"
                                              Padding="14,7" MinWidth="60"
                                              Content="{Binding AutostartEnabled, Converter={StaticResource BoolToOnOffConverter}}" />
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Style="{StaticResource SettingsHint}"
                                               Text="Launch VST Manager automatically when you sign in." />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <DockPanel LastChildFill="True">
                                <ToggleButton DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding StartMinimized}" Style="{StaticResource GhostToggleButton}"
                                              Padding="14,7" MinWidth="60"
                                              Content="{Binding StartMinimized, Converter={StaticResource BoolToOnOffConverter}}" />
                                <StackPanel>
                                    <TextBlock Text="Start minimized" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Style="{StaticResource SettingsHint}"
                                               Text="Open the main window minimized to the taskbar instead of full-sized — handy together with Start with Windows." />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <DockPanel LastChildFill="True">
                                <ToggleButton DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding MinimizeToTray}"
                                              Style="{StaticResource GhostToggleButton}"
                                              Padding="14,7" MinWidth="60"
                                              Content="{Binding MinimizeToTray, Converter={StaticResource BoolToOnOffConverter}}" />
                                <StackPanel>
                                    <TextBlock Text="Minimize to tray" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Style="{StaticResource SettingsHint}"
                                               Text="Closing the window hides it to the system tray instead of exiting — scanning and notifications keep running in the background. Right-click the tray icon to reopen or exit." />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <DockPanel LastChildFill="True">
                                <ToggleButton DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding ShowNotifications}"
                                              Style="{StaticResource GhostToggleButton}"
                                              Padding="14,7" MinWidth="60"
                                              Content="{Binding ShowNotifications, Converter={StaticResource BoolToOnOffConverter}}" />
                                <StackPanel>
                                    <TextBlock Text="Windows notifications" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Style="{StaticResource SettingsHint}"
                                               Text="Notify when new plugins are found, newer versions are available, and when a scan or metadata refresh finishes." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Scanning ============ -->
            <TabItem Style="{StaticResource SettingsNavItem}">
                <TabItem.Header>
                    <ctrl:SettingsTabHeader Icon="IconSliders" Text="Scanning" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Scan Folders" Style="{StaticResource SettingsSectionTitle}" />
                        <TextBlock Style="{StaticResource SettingsSectionCaption}"
                                   Text="Where VST Manager looks for installed plugins." />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Default locations" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,3,0,8"
                                           Text="The standard Windows VST folders. These are always scanned and can't be removed." />
                                <ItemsControl ItemsSource="{Binding DefaultVst3Paths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" Margin="0,1"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding DefaultVst2Paths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" Margin="0,1"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                                            Padding="12,6" FontSize="13" VerticalAlignment="Top"
                                            Click="AddFolder_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x002B;" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Add Folder" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="Your folders" Style="{StaticResource SettingsLabel}" />
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="Extra folders to include when scanning." />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding CustomScanFolders}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                                    Padding="10,6" Margin="0,0,0,5">
                                                <DockPanel LastChildFill="True">
                                                    <Button DockPanel.Dock="Right" Content="Remove"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="8,3" FontSize="12" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.RemoveScanFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,4,0,0"
                                           Text="No extra folders added yet."
                                           Visibility="{Binding CustomScanFolders.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverse}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Tags ============ -->
            <TabItem Style="{StaticResource SettingsNavItem}">
                <TabItem.Header>
                    <ctrl:SettingsTabHeader Icon="IconTag" Text="Tags" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Tags" Style="{StaticResource SettingsSectionTitle}" />
                        <TextBlock Style="{StaticResource SettingsSectionCaption}"
                                   Text="Label plugins by what they are. Built-in tags are filled in automatically from KVR; add your own for anything else you want to track." />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="New tag" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,3,0,10"
                                           Text="Pick a name and a colour. Tags can be applied by right-clicking a plugin, or to a whole selection at once." />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="NewTagNameBox" Width="180" Padding="8,6" FontSize="13"
                                             VerticalContentAlignment="Center"
                                             Background="{DynamicResource SurfaceAltBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" />
                                    <TextBox x:Name="NewTagColorBox" Width="100" Margin="8,0,0,0" Padding="8,6" FontSize="13"
                                             Text="#FF8A5CF6" FontFamily="Consolas"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Colour as #AARRGGBB or #RRGGBB"
                                             Background="{DynamicResource SurfaceAltBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" />
                                    <Button Content="Add Tag" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                            Padding="14,7" FontSize="13" Click="AddTag_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="All tags" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,3,0,10"
                                           Text="Built-in tags can be renamed and recoloured but not deleted — automatic detection relies on them." />
                                <ItemsControl ItemsSource="{Binding AvailableTags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource GhostButton}"
                                                        Padding="8,3" FontSize="12" Margin="6,0,0,0"
                                                        Click="DeleteTag_Click" Tag="{Binding}"
                                                        Visibility="{Binding IsPreset, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource GhostButton}"
                                                        Padding="8,3" FontSize="12"
                                                        Click="EditTag_Click" Tag="{Binding}" />
                                                <Border Width="12" Height="12" CornerRadius="6" VerticalAlignment="Center"
                                                        Margin="0,0,10,0"
                                                        Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Updates ============ -->
            <TabItem Style="{StaticResource SettingsNavItem}">
                <TabItem.Header>
                    <ctrl:SettingsTabHeader Icon="IconRefresh" Text="Updates" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource SettingsSectionTitle}" />
                        <TextBlock Style="{StaticResource SettingsSectionCaption}"
                                   Text="Keep VST Manager and your plugin metadata current." />

                        <Border Style="{StaticResource SettingsCard}">
                            <DockPanel LastChildFill="True">
                                <ToggleButton DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding CheckForPluginUpdatesOnStartup}"
                                              Style="{StaticResource GhostToggleButton}"
                                              Padding="14,7" MinWidth="60"
                                              Content="{Binding CheckForPluginUpdatesOnStartup, Converter={StaticResource BoolToOnOffConverter}}" />
                                <StackPanel>
                                    <TextBlock Text="Check plugins for updates on startup" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Style="{StaticResource SettingsHint}"
                                               Text="Looks up your installed plugins online each time the app opens to flag outdated ones. Turn this off to start faster or to avoid using the network — you can still check any time with Refresh All Metadata." />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,6"
                                            VerticalAlignment="Top" FontSize="13"
                                            Command="{Binding CheckForUpdatesCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x21BB;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Check Now" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentVersion, StringFormat='VST Manager {0}'}"
                                                   Style="{StaticResource SettingsLabel}" />
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="{Binding LastUpdateCheck, Converter={StaticResource LastCheckedConverter}}" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,10,0,0"
                                           Text="{Binding UpdateStatusText}"
                                           Visibility="{Binding UpdateStatusText, Converter={StaticResource StringToVisibilityConverter}}" />

                                <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                        Margin="0,12,0,0" Padding="12,6" FontSize="13"
                                        Content="{Binding UpdateButtonText}"
                                        Command="{Binding InstallOrOpenReleaseCommand}"
                                        IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource InverseBoolConverter}}"
                                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Data ============ -->
            <TabItem Style="{StaticResource SettingsNavItem}">
                <TabItem.Header>
                    <ctrl:SettingsTabHeader Icon="IconDatabase" Text="Data" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Backup &amp; Restore" Style="{StaticResource SettingsSectionTitle}" />
                        <TextBlock Style="{StaticResource SettingsSectionCaption}"
                                   Text="Move your library between machines, or keep a safety copy." />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Export" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,3,0,10"
                                           Text="Save your plugin tags, custom names and logos, scan folders and preferences to a single file." />
                                <Button Style="{StaticResource GhostButton}" Padding="12,6" HorizontalAlignment="Left"
                                        FontSize="13" Click="ExportData_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2B07;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Export to File..." VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Import" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,3,0,10"
                                           Text="Restore from a previously exported file. This replaces your current tags, folders and preferences." />
                                <Button Style="{StaticResource GhostButton}" Padding="12,6" HorizontalAlignment="Left"
                                        FontSize="13" Click="ImportData_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2B06;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Import from File..." VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Cloud ============ -->
            <TabItem Style="{StaticResource SettingsNavItem}">
                <TabItem.Header>
                    <ctrl:SettingsTabHeader Icon="IconCloud" Text="Cloud" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Cloud Sync" Style="{StaticResource SettingsSectionTitle}" />
                        <TextBlock Style="{StaticResource SettingsSectionCaption}"
                                   Text="Keep your settings mirrored to the cloud so a second machine picks up where this one left off." />

                        <Border Style="{StaticResource SettingsCard}">
                            <DockPanel LastChildFill="True">
                                <ToggleButton DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding CloudSyncEnabled}"
                                              Style="{StaticResource GhostToggleButton}"
                                              Padding="14,7" MinWidth="60"
                                              Content="{Binding CloudSyncEnabled, Converter={StaticResource BoolToOnOffConverter}}" />
                                <StackPanel>
                                    <TextBlock Text="Sync settings to MEGA" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Style="{StaticResource SettingsHint}"
                                               Text="Uploads the same data as an export — plugin tags, custom names and logos, scan folders and preferences. Changes upload a few seconds after you make them." />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Status" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,3,0,10"
                                           Text="{Binding CloudStatusMessage}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="13"
                                            Content="Sync Now" Command="{Binding SyncCloudNowCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="13" Margin="8,0,0,0"
                                            Content="Upload Now" Click="CloudUpload_Click"
                                            ToolTip="Overwrite the cloud copy with what's on this machine." />
                                    <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="13" Margin="8,0,0,0"
                                            Content="Restore from Cloud" Click="CloudRestore_Click"
                                            ToolTip="Overwrite this machine's settings with the cloud copy." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Sync ID" Style="{StaticResource SettingsLabel}" />
                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,3,0,10"
                                           Text="Identifies your settings in the cloud. To sync a second machine, paste this ID into its Sync ID box — both then share one copy." />
                                <TextBox Text="{Binding CloudDeviceId, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="12" Padding="8,6"
                                         Background="{DynamicResource SurfaceAltBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" />
                                <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="13"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Content="Use a Different ID..." Click="CloudChangeId_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="Vibe-coded with ❤️ by " />
                <Hyperlink Click="GitHubLink_Click" Foreground="{DynamicResource AccentBrush}">
                    <Run Text="K0D1M" />
                </Hyperlink>
            </TextBlock>

            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource GhostButton}"
                    Padding="20,7" Click="Close_Click" />
        </DockPanel>
    </Grid>
    </Grid>
</Window>
