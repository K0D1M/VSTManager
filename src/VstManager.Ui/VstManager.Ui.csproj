<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net10.0, deliberately: no -windows suffix is what lets this build for macOS. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.8.2</Version>
    <!-- The taskbar icon comes from the exe's own embedded resource, not the window's Icon=
         (that only covers the title bar/Alt-Tab thumbnail) — same artwork as WPF's app-icon.ico
         (VstManager.App/app-icon.ico), already present here under Assets/ for the window icon.
         A no-op on non-Windows RIDs, so safe to leave unconditional for the macOS build too. -->
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- NoStatus variant (dotnet build -p:NoLicenseStatus=true): the Legit/Cracked feature is
       compiled out entirely. C# uses #if !NO_LICENSE_STATUS. XAML has no conditional compilation,
       so status regions sit between comment markers "#if LICENSE_STATUS", optional "#else" and
       "#endif", and PreprocessConditionalXaml below cuts them before Avalonia compiles. It runs
       for the normal build too, which keeps the #if side and drops any #else side. -->
  <PropertyGroup>
    <KeepLicenseStatus>true</KeepLicenseStatus>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NoLicenseStatus)' == 'true'">
    <DefineConstants>$(DefineConstants);NO_LICENSE_STATUS</DefineConstants>
    <KeepLicenseStatus>false</KeepLicenseStatus>
  </PropertyGroup>

  <UsingTask TaskName="PreprocessConditionalXamlTask" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDir ParameterType="System.String" Required="true" />
      <LicenseStatus ParameterType="System.Boolean" Required="true" />
      <Processed ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var region = new Regex(
            @"^[ \t]*<!--#if LICENSE_STATUS-->[^\n]*\n(?<keep>.*?)(?:^[ \t]*<!--#else-->[^\n]*\n(?<alt>.*?))?^[ \t]*<!--#endif-->[^\n]*\n",
            RegexOptions.Singleline | RegexOptions.Multiline);
        var result = new List<ITaskItem>();
        foreach (var file in Files)
        {
            var text = File.ReadAllText(file.GetMetadata("FullPath"));
            if (!text.Contains("<!--#if LICENSE_STATUS-->"))
            {
                continue;
            }

            var crlf = text.Contains("\r\n");
            var output = region.Replace(text.Replace("\r\n", "\n"),
                m => LicenseStatus ? m.Groups["keep"].Value : m.Groups["alt"].Value);
            if (output.Contains("<!--#if LICENSE_STATUS-->") || output.Contains("<!--#endif-->"))
            {
                Log.LogError("Unbalanced LICENSE_STATUS markers in " + file.ItemSpec);
                return false;
            }
            if (crlf)
            {
                output = output.Replace("\n", "\r\n");
            }

            var relative = file.ItemSpec;
            var target = Path.Combine(OutputDir, relative);
            Directory.CreateDirectory(Path.GetDirectoryName(target));
            if (!File.Exists(target) || File.ReadAllText(target) != output)
            {
                File.WriteAllText(target, output, new System.Text.UTF8Encoding(true));
            }

            var item = new Microsoft.Build.Utilities.TaskItem(target);
            file.CopyMetadataTo(item);
            item.SetMetadata("Link", relative);
            item.SetMetadata("OriginalItemSpec", file.ItemSpec);
            result.Add(item);
        }
        Processed = result.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PreprocessConditionalXaml" BeforeTargets="PrepareForBuild">
    <PreprocessConditionalXamlTask Files="@(AvaloniaXaml)"
                                   OutputDir="$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(IntermediateOutputPath), conditional-xaml))"
                                   LicenseStatus="$(KeepLicenseStatus)">
      <Output TaskParameter="Processed" ItemName="_ConditionalXaml" />
    </PreprocessConditionalXamlTask>
    <ItemGroup>
      <AvaloniaXaml Remove="@(_ConditionalXaml->'%(OriginalItemSpec)')" />
      <AvaloniaXaml Include="@(_ConditionalXaml)" />
      <FileWrites Include="@(_ConditionalXaml)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\VstManager.Core\VstManager.Core.csproj" />

    <!-- A plain net10.0 project referencing a net10.0-windows10.0.19041.0 one is normally refused
         outright at restore time (NU1201) — NuGet's TFM compatibility graph has no notion of
         "reference it anyway, I only ever touch it through a portable interface type." Worked
         around in two parts: this ProjectReference builds the satellite project and keeps it in
         the dependency graph (so it's always up to date) but, via ReferenceOutputAssembly="false",
         never asks NuGet to validate or add its output as a compile-time reference, which is
         exactly the step NU1201 would otherwise block. The actual reference is the plain
         <Reference> below, pointed at that project's known build output by HintPath — a raw file
         reference is outside NuGet's compatibility graph entirely, the same mechanism used for
         referencing any prebuilt third-party DLL regardless of its own TFM. Safe here because
         nothing in this project ever names the satellite's own Windows-specific types — see
         NotificationService, which only ever holds the portable
         DesktopNotifications.INotificationManager interface. -->
    <!-- Not a ProjectReference: even with ReferenceOutputAssembly="false", MSBuild's own
         target-framework compatibility check (Microsoft.Common.CurrentVersion.targets,
         independent of NuGet's NU1201) refuses a plain net10.0 project referencing a
         net10.0-windows one outright. Built instead via the BeforeBuild target below, which
         invokes it out-of-band as a plain `dotnet build` — invisible to that compatibility check
         — and consumed purely as a prebuilt file Reference by HintPath. -->
    <Reference Include="VstManager.Ui.WindowsNotifications" Condition="'$(OS)' == 'Windows_NT'">
      <HintPath>..\VstManager.Ui.WindowsNotifications\bin\$(Configuration)\net10.0-windows10.0.19041.0\VstManager.Ui.WindowsNotifications.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="BuildWindowsNotificationsSatellite" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="dotnet build &quot;..\VstManager.Ui.WindowsNotifications\VstManager.Ui.WindowsNotifications.csproj&quot; -c $(Configuration)" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <!-- VstManager.Ui.WindowsNotifications is reached via a raw file Reference above, not a
         ProjectReference, so nothing copies its transitive dependency closure into this project's
         own output automatically the way an ordinary project-to-project reference would. That
         satellite project's CopyLocalLockFileAssemblies flattens the whole closure into its own
         bin folder; glob-copy everything from there except its own DLL/PDB, which the explicit
         Reference above already brings in. Condition on Windows_NT so an osx-arm64 build (where
         that folder never gets built) doesn't fail globbing a path that doesn't exist. -->
    <None Include="..\VstManager.Ui.WindowsNotifications\bin\$(Configuration)\net10.0-windows10.0.19041.0\**\*.*" Exclude="..\VstManager.Ui.WindowsNotifications\bin\$(Configuration)\net10.0-windows10.0.19041.0\VstManager.Ui.WindowsNotifications.dll;..\VstManager.Ui.WindowsNotifications\bin\$(Configuration)\net10.0-windows10.0.19041.0\VstManager.Ui.WindowsNotifications.pdb;..\VstManager.Ui.WindowsNotifications\bin\$(Configuration)\net10.0-windows10.0.19041.0\VstManager.Ui.WindowsNotifications.deps.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The .icns is consumed by build/make-app.py when laying out the macOS bundle, which
         copies it into Contents/Resources as a plain file. Embedding it as an Avalonia resource
         would add ~870KB of dead weight to every build without anything ever loading it. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\*.icns" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- Windows toast support comes in via VstManager.Ui.WindowsNotifications instead of a
         direct DesktopNotifications.Windows reference here — see that project reference's
         comment above for why. -->
    <PackageReference Include="DesktopNotifications" Version="1.3.1" />
    <PackageReference Include="DesktopNotifications.Apple" Version="1.3.1" />
  </ItemGroup>
</Project>
