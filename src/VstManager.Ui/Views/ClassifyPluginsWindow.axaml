<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VstManager.Ui.ViewModels"
        xmlns:model="using:VstManager.Core.Models"
        x:Class="VstManager.Ui.Views.ClassifyPluginsWindow"
        Title="New Plugins Found"
        Width="640" Height="640"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundGradient}">

    <Window.Styles>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,20">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="sectionHeader" Text="Give these plugins a category" />
            <TextBlock Classes="subtitle" TextWrapping="Wrap"
                       Text="A category is required for each plugin below. Plugins with more than one copy can also be marked Legit or Cracked per copy — anything left unmarked there stays unclassified." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PluginList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClassifyPluginViewModel">
                        <Border Classes="section" Margin="0,0,0,10">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Classes="subtitle" Text="{Binding Vendor}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).AvailableCategories}"
                                              Tag="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="model:CategoryDefinition">
                                            <!-- Tag carries the parent ClassifyPluginViewModel through to the
                                                 Click handler — the inner DataContext here is the category,
                                                 same "carry both values" reason SetCategory isn't a plain
                                                 Command. -->
                                            <Button Classes="ghost"
                                                    Tag="{Binding $parent[ItemsControl].Tag}"
                                                    Padding="8,4" FontSize="12"
                                                    Click="CategoryChip_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding Icon}" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Copies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ClassifyCopyViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                                                <Border Grid.Column="0" Classes="chip" VerticalAlignment="Center"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding FormatLabel}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Classes="meta" Text="{Binding Path}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Path}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                            Margin="10,0,0,0">
                                                    <ToggleButton Classes="filterToggle" Content="Legit"
                                                                  IsChecked="{Binding IsLegit}" />
                                                    <ToggleButton Classes="filterToggle" Content="Cracked"
                                                                  IsChecked="{Binding IsCracked}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
            <TextBlock Grid.Column="0" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="You can change any of this later from a plugin's detail window. Later leaves the category unset — you'll be asked again next scan." />
            <Button Grid.Column="1" Classes="ghost" Content="Later" Padding="18,8" Margin="0,0,8,0"
                    Click="Later_Click" />
            <Button x:Name="SaveButton" Grid.Column="2" Classes="accent" Content="Save" Padding="22,8"
                    Click="Save_Click"
                    ToolTip.Tip="Pick a category for every plugin above to enable Save" />
        </Grid>
    </Grid>
</Window>
