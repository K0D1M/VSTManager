<Window x:Class="VstManager.App.Views.CloudConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ctrl="clr-namespace:VstManager.App.Controls"
        mc:Ignorable="d"
        Title="Cloud Sync Conflict" Width="520"
        MinWidth="460" MinHeight="300" MaxHeight="760"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" SizeToContent="Height"
        Style="{StaticResource ChromedWindow}"
        Loaded="Window_Loaded"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctrl:CustomTitleBar Grid.Row="0" ShowMaximize="False"
                             TitleText="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                             TitleIcon="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Icon}" />

        <Grid Grid.Row="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="&#x2601;" FontSize="32" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Both copies changed" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Your settings changed on this machine and in the cloud since the last sync. Keeping one means discarding the other — there's no way to merge them." />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="This machine" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="LocalTimestampText" FontSize="14" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Cloud" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="RemoteTimestampText" FontSize="14" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <DockPanel Grid.Row="2" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Decide Later" Style="{StaticResource GhostButton}"
                        Padding="14,9" Click="DecideLater_Click"
                        ToolTip="Leaves both copies alone. Sync stays paused until you choose." />
                <Button DockPanel.Dock="Right" Content="Keep This Machine" Style="{StaticResource AccentButton}"
                        Padding="16,9" Margin="8,0,0,0" Click="KeepLocal_Click"
                        ToolTip="Uploads this machine's settings, replacing the cloud copy." />
                <Button DockPanel.Dock="Right" Content="Keep Cloud" Style="{StaticResource GhostButton}"
                        Padding="16,9" Click="KeepRemote_Click"
                        ToolTip="Downloads the cloud settings, replacing this machine's." />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
