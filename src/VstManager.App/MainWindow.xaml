<Window x:Class="VstManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VstManager.App"
        xmlns:vm="clr-namespace:VstManager.App.ViewModels"
        xmlns:conv="clr-namespace:VstManager.App.Converters"
        xmlns:core="clr-namespace:VstManager.Core.Models;assembly=VstManager.Core"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="VST Manager" Height="680" Width="1100"
        MinHeight="480" MinWidth="720"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <DataTemplate x:Key="PluginCardTemplate" DataType="{x:Type vm:PluginDisplayViewModel}">
            <Border Style="{StaticResource CardBorder}" Width="190">
                <Grid>
                    <StackPanel>
                        <Border Width="72" Height="72" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Image Width="72" Height="72" Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,72,72" RadiusX="10" RadiusY="10" />
                                </Image.Clip>
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource LogoConverter}">
                                        <Binding Path="LogoPath" />
                                        <Binding Path="IsInstalled" />
                                    </MultiBinding>
                                </Image.Source>
                                <Image.Opacity>
                                    <Binding Path="IsInstalled" Converter="{StaticResource OpacityConverter}" />
                                </Image.Opacity>
                            </Image>
                        </Border>

                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Vendor}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10" />

                        <Border Style="{StaticResource TagBadge}" HorizontalAlignment="Center"
                                Background="{Binding Tag, Converter={StaticResource TagBrushConverter}}">
                            <TextBlock Text="{Binding Tag, Converter={StaticResource TagTextConverter}}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>

                    <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,4,4,0" StrokeThickness="2"
                             Stroke="{DynamicResource SurfaceBrush}"
                             Fill="{Binding IsInstalled, Converter={StaticResource InstalledDotBrushConverter}}"
                             ToolTip="{Binding IsInstalled, Converter={StaticResource InstalledDotTooltipConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="VST Manager" FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <DockPanel Grid.Row="1" Margin="0,0,0,16" LastChildFill="False">
            <ToggleButton DockPanel.Dock="Left" Margin="0,0,14,0" Style="{StaticResource ModeToggleSwitch}"
                          IsChecked="{Binding Mode, Converter={StaticResource ModeToBoolConverter}}"
                          ToolTip="Toggle between managing Legit or Cracked plugins" />

            <Grid DockPanel.Dock="Left" Width="240" HorizontalAlignment="Left">
                <TextBox Style="{StaticResource SearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by name, vendor, or path" />
                <TextBlock Text="Search..." IsHitTestVisible="False" Margin="14,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button DockPanel.Dock="Right" Style="{StaticResource GearButton}" Margin="10,0,0,0"
                    Click="SettingsButton_Click" ToolTip="Settings" />

            <ToggleButton x:Name="FilterToggle" DockPanel.Dock="Right" Margin="10,0,0,0"
                          Style="{StaticResource FilterPopupButton}" ToolTip="Filters" />

            <Popup DockPanel.Dock="Right" PlacementTarget="{Binding ElementName=FilterToggle}"
                   Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=FilterToggle}"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Style="{StaticResource CardBorder}" Width="260" Margin="0,6,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Filters" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource GhostButton}"
                                    Padding="8,3" FontSize="11" HorizontalAlignment="Right"
                                    Command="{Binding ResetFiltersCommand}" />
                        </DockPanel>

                        <TextBlock Text="Status" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton Content="All" GroupName="Status" Style="{StaticResource FilterPill}"
                                         IsChecked="{Binding InstalledFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:InstalledFilterOption.All}}" />
                            <RadioButton Content="Installed" GroupName="Status" Style="{StaticResource FilterPill}"
                                         IsChecked="{Binding InstalledFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:InstalledFilterOption.InstalledOnly}}" />
                            <RadioButton Content="Not Installed" GroupName="Status" Style="{StaticResource FilterPill}"
                                         IsChecked="{Binding InstalledFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:InstalledFilterOption.NotInstalledOnly}}" />
                        </StackPanel>

                        <TextBlock Text="Format" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="All" GroupName="Format" Style="{StaticResource FilterPill}"
                                         IsChecked="{Binding FormatFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:FormatFilterOption.All}}" />
                            <RadioButton Content="VST2" GroupName="Format" Style="{StaticResource FilterPill}"
                                         IsChecked="{Binding FormatFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:FormatFilterOption.Vst2}}" />
                            <RadioButton Content="VST3" GroupName="Format" Style="{StaticResource FilterPill}"
                                         IsChecked="{Binding FormatFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:FormatFilterOption.Vst3}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                    Command="{Binding RescanCommand}" ToolTip="Rescan for installed plugins">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x21BB;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Rescan" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding PluginsView}" ItemTemplate="{StaticResource PluginCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style>
                        <Setter Property="FrameworkElement.Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Setter Property="FrameworkElement.ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Mark Legit"
                                              IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding PlacementTarget.Tag.MarkLegitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#x2714;" Foreground="{DynamicResource LegitBrush}" FontSize="13" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Mark Cracked"
                                              IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding PlacementTarget.Tag.MarkCrackedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#x2620;" Foreground="{DynamicResource CrackedBrush}" FontSize="13" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Refresh Metadata"
                                              IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding PlacementTarget.Tag.RefreshMetadataCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#x21BB;" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Show in Folder"
                                              IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <Path Data="M1,3 L6,3 L7.5,4.5 L15,4.5 L15,13 L1,13 Z"
                                                  Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="14" Height="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Uninstall..."
                                              IsEnabled="{Binding PlacementTarget.DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding PlacementTarget.Tag.UninstallCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#x2716;" Foreground="{DynamicResource CrackedBrush}" FontSize="13" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
