<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Vector icons that don't fit the plain Unicode-glyph TextBlocks used everywhere else in
        this project — cloud sync and MEGA branding both need a specific silhouette a font glyph
        can't give. Path data is ported verbatim from the WPF app's Themes/Styles.xaml, which is
        itself the source of truth for both shapes.
    -->

    <!-- Cloud silhouette, from VstManager.App/MainWindow.xaml's toolbar sync indicator. -->
    <StreamGeometry x:Key="CloudGlyph">M6.5,19 A4.5,4.5 0 0,1 6.5,10 A6,6 0 0,1 18,8.5 A4.25,4.25 0 0,1 17.5,19 Z</StreamGeometry>

    <!-- MEGA's "M" wordmark glyph, re-based into a 0,0..721,721 space — see the identical note in
         VstManager.App/Themes/Styles.xaml, which this is ported from verbatim. Drawn over a red
         circle the same size (see the MEGA badge in Views/SettingsWindow.axaml's Cloud tab). -->
    <!-- Google Drive mark as its three coloured bands, 24x24 box. -->
    <StreamGeometry x:Key="DriveGreen">M8.5,3 L1,16 L4.5,22 L12,9 Z</StreamGeometry>
    <StreamGeometry x:Key="DriveYellow">M8.5,3 L15.5,3 L23,16 L16,16 Z</StreamGeometry>
    <StreamGeometry x:Key="DriveBlue">M4.5,22 L19.5,22 L23,16 L8,16 Z</StreamGeometry>
    <StreamGeometry x:Key="MegaGlyph">M147.5 214.5 h85 l128 130 129-130 h82 v293 h-86 V337.75 L380.834 442.5 h-40.668 L235.5 337.75 V507.5 h-88 z</StreamGeometry>

    <!-- Settings tab icons, ported verbatim from VstManager.App/Themes/Styles.xaml (same source
         of truth as the two shapes above) so the Avalonia Settings tabs match WPF's exactly
         rather than approximating them. The Appearance tab (WPF has no equivalent) instead reuses
         the plain ◐ glyph already on the main window's theme-toggle button — no geometry needed
         there, see SettingsWindow.axaml. -->
    <StreamGeometry x:Key="IconGeneral">M12,15.5 A3.5,3.5 0 1 1 12,8.5 A3.5,3.5 0 1 1 12,15.5 M12,2.5 L12,5 M12,19 L12,21.5 M4.2,4.2 L6,6 M18,18 L19.8,19.8 M2.5,12 L5,12 M19,12 L21.5,12 M4.2,19.8 L6,18 M18,6 L19.8,4.2</StreamGeometry>
    <StreamGeometry x:Key="IconSliders">M4,21 L4,14 M4,10 L4,3 M12,21 L12,12 M12,8 L12,3 M20,21 L20,16 M20,12 L20,3 M1,14 L7,14 M9,8 L15,8 M17,16 L23,16</StreamGeometry>
    <StreamGeometry x:Key="IconTag">M11.5,3.5 L20.5,3.5 L20.5,12.5 L12,21 L3.5,12.5 L3.5,4 Z M7.5,7.5 L7.6,7.5</StreamGeometry>
    <StreamGeometry x:Key="IconDatabase">M4,6 C4,4.6 7.6,3.5 12,3.5 C16.4,3.5 20,4.6 20,6 C20,7.4 16.4,8.5 12,8.5 C7.6,8.5 4,7.4 4,6 Z M4,6 L4,18 C4,19.4 7.6,20.5 12,20.5 C16.4,20.5 20,19.4 20,18 L20,6 M4,12 C4,13.4 7.6,14.5 12,14.5 C16.4,14.5 20,13.4 20,12</StreamGeometry>

    <!-- No WPF equivalent — the About tab is new to this project (see SettingsWindow.axaml's
         About tab). A plain info-circle, drawn fresh to match the others' stroke-based style
         rather than a filled glyph. -->
    <StreamGeometry x:Key="IconInfo">M12,21.5 A9.5,9.5 0 1 1 12,2.5 A9.5,9.5 0 1 1 12,21.5 M12,11 L12,16.5 M12,7.5 L12,7.6</StreamGeometry>

    <!--#if LICENSE_STATUS-->
    <!-- Legit/Cracked mode-segment icons (MainWindow.axaml's All/Legit/Cracked toolbar toggle),
         ported verbatim from WPF's Styles.xaml:20-21 — WPF itself renders that particular spot
         with the flat ✔/☠ Unicode characters via a Tag-bound TextBlock, but these proper vector
         geometries already existed there for other uses, and look better than the flat glyphs. -->
    <StreamGeometry x:Key="IconCheck">M4,12.5 L9.5,18 L20,6</StreamGeometry>
    <StreamGeometry x:Key="IconSkull">M12,2.5 C7,2.5 4.5,6 4.5,9.8 C4.5,12.1 5.7,14 7.5,15.1 L7.5,18.4 C7.5,19.5 8.4,20.4 9.5,20.4 L14.5,20.4 C15.6,20.4 16.5,19.5 16.5,18.4 L16.5,15.1 C18.3,14 19.5,12.1 19.5,9.8 C19.5,6 17,2.5 12,2.5 Z M9,10.4 L9.4,10.4 M14.6,10.4 L15,10.4 M10.7,16.6 L10.7,16.7 M13.3,16.6 L13.3,16.7</StreamGeometry>
    <!--#endif-->

    <!-- Filter button icon (MainWindow.axaml's toolbar). Ported verbatim from WPF's Styles.xaml:29
         — a FILLED funnel silhouette, unlike the stroke-based icons above, so it renders with
         Fill, not the tabIcon/segmentIcon stroke styles. -->
    <StreamGeometry x:Key="IconFunnel">M3,4.5 L21,4.5 L14.5,12 L14.5,19 L9.5,16.5 L9.5,12 Z</StreamGeometry>

    <!-- No WPF equivalent — the toolbar's "Hidden" toggle and the Filter popup's "Show hidden
         plugins" toggle are both Avalonia-only additions from an earlier session, drawn fresh in
         the same stroke-based style as the other icons above rather than using an emoji, which
         has no reliable matching "eye" / "eye with a slash through it" pair across platforms. -->
    <StreamGeometry x:Key="IconEye">M1.5,12 C1.5,12 5,5 12,5 C19,5 22.5,12 22.5,12 C22.5,12 19,19 12,19 C5,19 1.5,12 1.5,12 Z M12,15 A3,3 0 1 0 12,9 A3,3 0 1 0 12,15 Z</StreamGeometry>
    <StreamGeometry x:Key="IconEyeOff">M1.5,12 C1.5,12 5,5 12,5 C19,5 22.5,12 22.5,12 C22.5,12 19,19 12,19 C5,19 1.5,12 1.5,12 Z M12,15 A3,3 0 1 0 12,9 A3,3 0 1 0 12,15 Z M3,3 L21,21</StreamGeometry>

    <!-- Plugin context menu (MainWindow.axaml's PluginMenu). IconRefresh ported verbatim from
         WPF's Styles.xaml:26 (already used there for "Refresh Metadata"; reused here as-is for
         Re-detect Version). IconClear has no WPF equivalent for this menu item — WPF's own menu
         doesn't show a "Clear Classification" icon either, so this is drawn fresh. -->
    <StreamGeometry x:Key="IconRefresh">M23,4 L23,10 L17,10 M1,20 L1,14 L7,14 M3.5,9 A9,9 0 0 1 18.4,5.6 L23,10 M1,14 L5.6,18.4 A9,9 0 0 0 20.5,15</StreamGeometry>
    <StreamGeometry x:Key="IconClear">M12,21.5 A9.5,9.5 0 1 1 12,2.5 A9.5,9.5 0 1 1 12,21.5 Z M7,7 L17,17</StreamGeometry>

    <!-- No WPF equivalent — CloudConflictWindow's "This machine" side, paired with the existing
         CloudGlyph for its "Cloud copy" side. A plain monitor/desktop silhouette, drawn fresh in
         the same stroke-based style as the other icons above. -->
    <StreamGeometry x:Key="IconComputer">M2.5,4.5 L21.5,4.5 L21.5,15.5 L2.5,15.5 Z M8,19.5 L16,19.5 M9.5,15.5 L9.5,17.5 M14.5,15.5 L14.5,17.5</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M10.5,17 A6.5,6.5 0 1 1 10.5,4 A6.5,6.5 0 1 1 10.5,17 M15.2,15.2 L20,20</StreamGeometry>
    <!-- Update mark: a refresh arrow around a download arrow. -->
    <StreamGeometry x:Key="IconUpdate">M20,12 A8,8 0 1 1 17.66,6.34 M20,4 L20,8 L16,8 M12,8 L12,15 M9,12 L12,15 L15,12</StreamGeometry>
    <StreamGeometry x:Key="IconDownload">M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20</StreamGeometry>
    <StreamGeometry x:Key="IconExternal">M14,4 L20,4 L20,10 M20,4 L11,13 M18,14 L18,19 L5,19 L5,6 L10,6</StreamGeometry>

</ResourceDictionary>
