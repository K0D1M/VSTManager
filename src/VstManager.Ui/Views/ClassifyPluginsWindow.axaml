<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VstManager.Ui.ViewModels"
        xmlns:model="using:VstManager.Core.Models"
        xmlns:li="using:VstManager.Ui.Views"
        xmlns:conv="using:VstManager.Ui.Converters"
        x:Class="VstManager.Ui.Views.ClassifyPluginsWindow"
        Title="New Plugins Found"
        Width="640" Height="640"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundGradient}">

    <Window.Styles>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,20">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="sectionHeader" Text="Give these plugins a category" />
            <!--#if LICENSE_STATUS-->
            <TextBlock Classes="subtitle" TextWrapping="Wrap"
                       Text="Pick a category and mark each copy Legit or Cracked. Once every plugin is set you'll be asked to apply the changes." />
            <!--#else-->
            <TextBlock Classes="subtitle" TextWrapping="Wrap"
                       Text="Pick a category for each plugin below. Once every plugin has one you'll be asked to apply the changes." />
            <!--#endif-->
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PluginList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClassifyPluginViewModel">
                        <Border Classes="section classifyCard" Margin="0,0,0,10">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Classes="subtitle" Text="{Binding Vendor}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).AvailableCategories}"
                                              Tag="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="model:CategoryDefinition">
                                            <!-- Tag carries the parent ClassifyPluginViewModel through to the
                                                 Click handler — the inner DataContext here is the category,
                                                 same "carry both values" reason SetCategory isn't a plain
                                                 Command. -->
                                            <Button Classes="ghost categoryChip"
                                                    Tag="{Binding $parent[ItemsControl].Tag}"
                                                    Padding="8,4" FontSize="12"
                                                    Click="CategoryChip_Click">
                                                <Classes.selected>
                                                    <MultiBinding Converter="{x:Static conv:EqualityMultiConverter.Instance}">
                                                        <Binding Path="Id" />
                                                        <Binding Path="$parent[ItemsControl].((vm:ClassifyPluginViewModel)Tag).SelectedCategoryId" />
                                                    </MultiBinding>
                                                </Classes.selected>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <li:CategoryIcon CategoryId="{Binding Id}" Emoji="{Binding Icon}" IconSize="14" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Copies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ClassifyCopyViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                                                <Border Grid.Column="0" Classes="chip" VerticalAlignment="Center"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding FormatLabel}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Classes="meta" Text="{Binding Path}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Path}" />
                                                <!--#if LICENSE_STATUS-->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                            Margin="10,0,0,0">
                                                    <ToggleButton Classes="filterToggle legit" Content="Legit"
                                                                  IsChecked="{Binding IsLegit}" />
                                                    <ToggleButton Classes="filterToggle cracked" Content="Cracked"
                                                                  IsChecked="{Binding IsCracked}" />
                                                </StackPanel>
                                                <!--#endif-->
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <TextBlock Grid.Column="0" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="You can change any of this later from a plugin's detail window. Plugins you don't finish come back after the next scan." />
            <Button Grid.Column="1" Classes="ghost" Content="Close" Padding="18,8" Margin="12,0,0,0"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
