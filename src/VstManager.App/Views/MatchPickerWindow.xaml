<Window x:Class="VstManager.App.Views.MatchPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Which plugin is this?" Width="520" Height="520"
        MinWidth="440" MinHeight="380"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Which plugin is this?" FontSize="19" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="SubtitleText" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CandidateList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" CornerRadius="10" Padding="12,10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="True">
                                <RadioButton DockPanel.Dock="Left" GroupName="Candidate" VerticalAlignment="Center"
                                             Margin="0,0,10,0" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                <Button DockPanel.Dock="Right" Content="View page" Style="{StaticResource GhostButton}"
                                        Padding="8,4" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Tag="{Binding SourceUrl}" Click="ViewPage_Click"
                                        Visibility="{Binding HasSourceUrl, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock FontSize="12" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding VendorText, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding VersionText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding ConfidenceText}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="None of these" Style="{StaticResource GhostButton}"
                    Click="NoneOfThese_Click"
                    ToolTip="Keep the current details unchanged" />
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Apply_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2713;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Use this one" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
