<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VstManager.Ui.ViewModels"
        x:Class="VstManager.Ui.Views.ClassifyPluginsWindow"
        Title="Classify New Plugins"
        Width="640" Height="600"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundGradient}">

    <Window.Styles>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,20">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="sectionHeader" Text="These plugins have more than one copy" />
            <TextBlock Classes="subtitle" TextWrapping="Wrap"
                       Text="Each copy can be marked separately — useful when one is a legitimate install and another isn't. Anything left unmarked stays unclassified." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PluginList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClassifyPluginViewModel">
                        <Border Classes="section" Margin="0,0,0,10">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Classes="subtitle" Text="{Binding Vendor}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Copies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ClassifyCopyViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                                                <Border Grid.Column="0" Classes="chip" VerticalAlignment="Center"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding FormatLabel}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Classes="meta" Text="{Binding Path}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Path}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                            Margin="10,0,0,0">
                                                    <ToggleButton Classes="filterToggle" Content="Legit"
                                                                  IsChecked="{Binding IsLegit}" />
                                                    <ToggleButton Classes="filterToggle" Content="Cracked"
                                                                  IsChecked="{Binding IsCracked}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
            <TextBlock Grid.Column="0" Classes="meta" VerticalAlignment="Center"
                       Text="You can change any of this later from a plugin's detail window." />
            <Button Grid.Column="1" Classes="ghost" Content="Later" Padding="18,8" Margin="0,0,8,0"
                    Click="Later_Click" />
            <Button Grid.Column="2" Classes="accent" Content="Save" Padding="22,8"
                    Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
