<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#FFF3F3F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFEDEDF5</Color>
    <Color x:Key="BorderColor">#FFDCDCE6</Color>
    <Color x:Key="TextPrimaryColor">#FF1B1B23</Color>
    <Color x:Key="TextSecondaryColor">#FF6B6B7A</Color>
    <Color x:Key="AccentColor">#FF6D28D9</Color>
    <Color x:Key="AccentColorHover">#FF7C3AED</Color>
    <Color x:Key="TealAccentColor">#FF0D9488</Color>
    <Color x:Key="LegitColor">#FF059669</Color>
    <Color x:Key="CrackedColor">#FFDC2626</Color>
    <Color x:Key="UnclassifiedColor">#FF64748B</Color>
    <Color x:Key="OutdatedColor">#FFD97706</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorHover}" />
    <SolidColorBrush x:Key="TealAccentBrush" Color="{StaticResource TealAccentColor}" />
    <SolidColorBrush x:Key="LegitBrush" Color="{StaticResource LegitColor}" />
    <SolidColorBrush x:Key="CrackedBrush" Color="{StaticResource CrackedColor}" />
    <SolidColorBrush x:Key="UnclassifiedBrush" Color="{StaticResource UnclassifiedColor}" />
    <SolidColorBrush x:Key="OutdatedBrush" Color="{StaticResource OutdatedColor}" />

</ResourceDictionary>
