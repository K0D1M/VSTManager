<Window x:Class="VstManager.App.Views.FolderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ctrl="clr-namespace:VstManager.App.Controls"
        xmlns:svc="clr-namespace:VstManager.App.Services"
        mc:Ignorable="d"
        Title="Folder" Width="460"
        MinWidth="420" MinHeight="300"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height"
        Style="{StaticResource ChromedWindow}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctrl:CustomTitleBar Grid.Row="0" ShowMaximize="False"
                             TitleText="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                             TitleIcon="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Icon}" />

        <StackPanel Grid.Row="1" Margin="26,20,26,22" svc:UiScale.ScaleContent="True">

            <!-- Live preview of the folder row, so the icon/colour choices are judged as they'll
                 actually appear rather than as raw values. -->
            <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,18"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="PreviewSwatch" Width="4" CornerRadius="2" Margin="0,0,10,0"
                            Background="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="PreviewIcon" Text="&#x1F4C1;" FontFamily="{StaticResource EmojiFontFamily}" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="PreviewName" Text="New Folder" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Name" FontSize="12" Margin="0,0,0,5"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="NameBox" Padding="9,7" FontSize="13" Margin="0,0,0,16"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource SurfaceAltBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                     TextChanged="Field_Changed" />

            <TextBlock Text="Icon" FontSize="12" Margin="0,0,0,5"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="Pick one, or type any emoji below."
                       FontSize="11" Margin="0,0,0,7"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ItemsControl x:Name="IconChoices" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- The glyph goes in an explicit TextBlock with the font set on it: a
                             bare string Content is rendered by an implicitly-created TextBlock,
                             which picks up the app-wide TextBlock style and its non-icon font.
                             IconGlyphFontFamily (Segoe Fluent Icons), not EmojiFontFamily: these
                             presets are vector UI icons, not colour emoji — see the comment on
                             IconGlyphFontFamily in Styles.xaml for why that distinction matters. -->
                        <Button Width="34" Height="34" Tag="{Binding}"
                                Margin="0,0,5,5" Click="IconChoice_Click"
                                Style="{StaticResource GhostButton}">
                            <TextBlock Text="{Binding}" FontSize="16"
                                       FontFamily="{StaticResource IconGlyphFontFamily}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="IconBox" Padding="9,7" FontSize="13" Margin="0,0,0,16" MaxLength="8"
                     FontFamily="{StaticResource EmojiFontFamily}"
                     VerticalContentAlignment="Center"
                     ToolTip="Any emoji. Leave empty for a plain folder icon."
                     Background="{DynamicResource SurfaceAltBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                     TextChanged="Field_Changed" />

            <TextBlock Text="Colour" FontSize="12" Margin="0,0,0,5"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ItemsControl x:Name="ColorChoices" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="28" Height="28" Margin="0,0,5,5" Padding="0"
                                Click="ColorChoice_Click" Tag="{Binding}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" />
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Background>
                                <SolidColorBrush Color="{Binding}" />
                            </Button.Background>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="ColorBox" Padding="9,7" FontSize="13" FontFamily="Consolas" Margin="0,0,0,22"
                     VerticalContentAlignment="Center"
                     ToolTip="Colour as #AARRGGBB or #RRGGBB"
                     Background="{DynamicResource SurfaceAltBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                     TextChanged="Field_Changed" />

            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource AccentButton}"
                        Padding="18,8" FontSize="13" IsDefault="True" Click="Save_Click" />
                <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource GhostButton}"
                        Padding="16,8" FontSize="13" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
